			<Color x:Key="SukiInformationDarkColor">#CC7A7A7A</Color>
			<Color x:Key="ThemeControlLowColor">#FF8B8B8B</Color>
			<Color x:Key="ThemeControlMidHighColor">#FFC3C3C3</Color>
			<Color x:Key="GlassBorderBrush">#FF343434</Color>
			<Color x:Key="ThemeBackgroundColor">#FF1E1E1E</Color>
			<SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Color="#FF3F3F3F" Opacity="0.75" />

