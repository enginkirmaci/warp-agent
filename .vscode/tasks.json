{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (warp-agent)",
            "type": "shell",
            "command": "cargo",
            "args": ["build"],
            "options": { "cwd": "${workspaceFolder}/rust" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$rustc"
        }
    ]
}
