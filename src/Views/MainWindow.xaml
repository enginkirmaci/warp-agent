<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="WarpAgent.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:WarpAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:v="using:WarpAgent.Views"
	xmlns:vm="using:WarpAgent.ViewModels"
	Title="Warp Agent"
	Icon="avares://WarpAgent/Assets/spark.png"
	Width="1180"
	Height="800"
	MinWidth="860"
	MinHeight="580"
	BackgroundStyle="Flat"
	BackgroundAnimationEnabled="False"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">

	<suki:SukiWindow.LogoContent>
		<PathIcon Data="{StaticResource IconSpark}" Width="{DynamicResource IconLarge}" Height="{DynamicResource IconLarge}" Foreground="{DynamicResource TextMutedBrush}" />
	</suki:SukiWindow.LogoContent>

	<suki:SukiWindow.Styles>
		<!--  flatten the titlebar too: the SukiUI shader (waves/gradient) must never show.
		      PART_TitleBarBackground is a GlassCard, not a Border — its card layer paints
		      the background at GlassOpacity (0.18) so the shader bleeds through, and
		      PART_ClipBorder stacks another tint on top; pin both to the flat chrome  -->
		<Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground /template/ Border.GlassCardBorderPartCard">
			<Setter Property="Background" Value="{DynamicResource WindowChromeBrush}" />
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground /template/ Border#PART_ClipBorder">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<!--  SukiUI's hairline under the titlebar  -->
		<Style Selector="suki|SukiWindow /template/ Border#PART_BottomBorder">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="{DynamicResource SuccessDimBrush}" />
		</Style>
		<Style Selector="TextBlock.sidebar-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,8" />
		</Style>

		<!--  sidebar rows draw their own hover + selection; SukiUI's check badge and
		      selected tint are suppressed — selection is the accent border only  -->
		<Style Selector="Border.row-card">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<!--  the focused chat's row keeps a soft accent tint; hover still wins while pointing  -->
		<Style Selector="Border.row-card.selected">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
		</Style>
		<Style Selector="Border.row-card:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  workspace row actions appear on hover only  -->
		<Style Selector="Button.ws-action">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Border.row-card:pointerover Button.ws-action">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<!--  the Workspaces header's + behaves the same: hidden until the header is hovered  -->
		<Style Selector="Grid.projects-header Button.ws-action">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Grid.projects-header:pointerover Button.ws-action">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="TextBlock.task-done">
			<Setter Property="TextDecorations" Value="Strikethrough" />
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!--  buttons  -->
		<Style Selector="Button.btn-soft">
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.btn-soft:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  relaunch banner: flat hairline chip floating at the top of the tile grid  -->
		<Style Selector="Border.restore-bar">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="14,7" />
		</Style>
		<Style Selector="Border.restore-bar Button.btn-soft">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Padding" Value="12,3" />
		</Style>

		<!--  sidebar footer settings button: bare icon+label, tint on hover only  -->
		<Style Selector="Button.settings-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>
		<Style Selector="Button.settings-btn:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  accent swatches: chrome-less color dot, muted ring when its preset is picked  -->
		<Style Selector="RadioButton.accent-swatch">
			<Setter Property="Template">
				<ControlTemplate>
					<Border
						x:Name="SwatchDot"
						Width="24"
						Height="24"
						CornerRadius="12"
						Background="{Binding SwatchBrush}"
						BorderThickness="2"
						BorderBrush="Transparent" />
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="RadioButton.accent-swatch:checked /template/ Border#SwatchDot">
			<Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="RadioButton.accent-swatch:pointerover /template/ Border#SwatchDot">
			<Setter Property="Opacity" Value="0.8" />
		</Style>

		<!--  settings page: muted section label above a hairline card; rows are label + control  -->
		<Style Selector="TextBlock.settings-section">
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="Margin" Value="2,0,0,0" />
		</Style>
		<Style Selector="Border.settings-card">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16,12" />
		</Style>
		<Style Selector="TextBlock.settings-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Left" />
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
		<Style Selector="TextBlock.settings-label">
			<Setter Property="FontSize" Value="{DynamicResource FontBody}" />
			<Setter Property="Opacity" Value="0.9" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  sidebar resize handle: invisible until hovered  -->
		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="GridSplitter:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<!--  error overlay: the crash-guard dialog shown over everything  -->
		<Style Selector="Border.error-dialog">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="18" />
		</Style>
		<Style Selector="Border.error-detail">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10" />
		</Style>
		<Style Selector="TextBlock.error-sub">
			<Setter Property="FontSize" Value="{DynamicResource FontXSmall}" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="TextBlock.error-mono">
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="{DynamicResource FontDetail}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--  painted root: solid flat canvas over the SukiUI shader — no gradient, no waves.
	      the chrome — titlebar, sidebar and the ring around the main card — paints
	      WindowChromeBrush; the main area floats on it as a rounded SurfaceBrush card  -->
	<Grid x:Name="LayoutRoot" Background="{DynamicResource WindowChromeBrush}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="12" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  Sidebar: workspaces + their chats  -->
		<Border
			Grid.Column="0"
			Margin="10,10,0,10"
			Padding="10">
				<Grid RowDefinitions="*,Auto">
					<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
						<!--  explicit viewport width: the ScrollViewer's own horizontal measure goes
						      stale across splitter drags, leaving the rows shifted/overflowing  -->
						<StackPanel Width="{Binding $parent[ScrollViewer].Viewport.Width}" Spacing="10">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Classes="projects-header">
								<TextBlock
									Text="Workspaces"
									FontSize="{DynamicResource FontSmall}"
									FontWeight="SemiBold"
									Opacity="0.7"
									VerticalAlignment="Center" />
								<Button
									Grid.Column="1"
									Classes="icon ws-action"
									Click="OnAddWorkspaceClicked"
									ToolTip.Tip="Add workspace folder">
									<PathIcon Data="{StaticResource IconPlus}" Width="{DynamicResource IconBody}" Height="{DynamicResource IconBody}" />
								</Button>
							</Grid>
							<ItemsControl ItemsSource="{Binding Workspaces}">
								<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,1">
											<Border
												Classes="row-card"
												ToolTip.Tip="{Binding FolderPath}"
												Tapped="OnWorkspaceClick">
													<Border.ContextMenu>
														<ContextMenu>
															<MenuItem Header="Start server" Click="OnWorkspaceStartClick" IsVisible="{Binding !IsRunning}" />
															<MenuItem Header="Stop server" Click="OnWorkspaceStopClick" IsVisible="{Binding IsRunning}" />
															<MenuItem Header="Remove workspace" Click="OnWorkspaceRemoveClick" />
														</ContextMenu>
													</Border.ContextMenu>
<Grid ColumnDefinitions="*,Auto">
												<StackPanel Orientation="Horizontal" Spacing="7">
													<Panel VerticalAlignment="Center">
														<PathIcon
															Data="{StaticResource IconFolderOpenOutline}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource TextMutedBrush}"
															IsVisible="{Binding IsExpanded}" />
														<PathIcon
															Data="{StaticResource IconFolderOutline}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource TextMutedBrush}"
															IsVisible="{Binding !IsExpanded}" />
													</Panel>
															<TextBlock
																Text="{Binding Name}"
																TextTrimming="CharacterEllipsis"
																FontSize="{DynamicResource FontBody}"
																VerticalAlignment="Center" />
															<Ellipse
																Width="6"
																Height="6"
																Fill="{DynamicResource SuccessBrush}"
																VerticalAlignment="Center"
																IsVisible="{Binding IsRunning}" />
														</StackPanel>
														<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
															<Button
																Classes="icon ws-action"
																Click="OnWorkspaceMenuClick"
																ToolTip.Tip="Workspace actions">
																<PathIcon Data="{StaticResource IconKebab}" Width="{DynamicResource IconBody}" Height="{DynamicResource IconBody}" />
															</Button>
															<Button
																Classes="icon ws-action"
																Command="{Binding $parent[ItemsControl].DataContext.NewChatForWorkspaceCommand}"
																CommandParameter="{Binding}"
																ToolTip.Tip="New chat in this workspace">
																<PathIcon Data="{StaticResource IconChatOutline}" Width="{DynamicResource IconBody}" Height="{DynamicResource IconBody}" />
															</Button>
														</StackPanel>
													</Grid>
												</Border>
											<StackPanel IsVisible="{Binding IsExpanded}">
												<TextBlock
													Classes="sidebar-hint"
													Margin="26,1,0,1"
													HorizontalAlignment="Left"
													TextAlignment="Left"
													IsVisible="{Binding ShowEmptyHint}"
													Text="No chats yet" />
												<ItemsControl ItemsSource="{Binding Chats}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border
															Classes="row-card"
															Classes.selected="{Binding IsSelected}"
															Margin="26,0,0,0"
															ToolTip.Tip="{Binding Title}"
															Tapped="OnSessionClick">
															<Border.ContextMenu>
																<ContextMenu>
																	<MenuItem Header="Pin" Click="OnPinClick" IsVisible="{Binding !IsPinned}" />
																	<MenuItem Header="Unpin" Click="OnUnpinClick" IsVisible="{Binding IsPinned}" />
																	<MenuItem Header="Rename" Click="OnRenameClick" />
																	<MenuItem Header="Copy share link" Click="OnShareClick" />
																	<MenuItem Header="Stop sharing" Click="OnUnshareClick" />
																	<MenuItem Header="Remove from workspace" Click="OnUnlinkClick" />
																	<MenuItem Header="Delete" Click="OnDeleteClick" />
																</ContextMenu>
															</Border.ContextMenu>
															<Grid ColumnDefinitions="13,*,Auto" ColumnSpacing="5">
																<!--  gutter: spinner while the turn runs, pin otherwise —
																      titles stay aligned across all chat rows  -->
																<Panel VerticalAlignment="Center">
																	<PathIcon
																		Classes="spin"
																		Data="{StaticResource IconSpinner}"
																		Width="{DynamicResource IconSmall}"
																		Height="{DynamicResource IconSmall}"
																		IsVisible="{Binding IsRunning}" />
																	<PathIcon
																		Data="{StaticResource IconPin}"
																		Width="{DynamicResource IconXSmall}"
																		Height="{DynamicResource IconXSmall}"
																		Foreground="{DynamicResource TextMutedBrush}"
																		VerticalAlignment="Center"
																		IsVisible="{Binding PinVisible}" />
																</Panel>
																<TextBlock
																	Grid.Column="1"
																	Text="{Binding Title}"
																	TextTrimming="CharacterEllipsis"
																	FontSize="{DynamicResource FontBody}"
																	VerticalAlignment="Center"
																	IsVisible="{Binding !IsEditing}" />
																<TextBox
																	Grid.Column="1"
																	Text="{Binding DraftTitle}"
																	IsVisible="{Binding IsEditing}"
																	KeyDown="OnRenameKeyDown"
																	LostFocus="OnRenameLostFocus" />
																<TextBlock
																	Grid.Column="2"
																	Text="{Binding UpdatedLabel}"
																	FontSize="{DynamicResource FontMicro}"
																	Opacity="0.45"
																	VerticalAlignment="Center"
																	IsVisible="{Binding !IsEditing}" />
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasNoWorkspace}"
								Text="Add a workspace folder to begin." />
						</StackPanel>
					</ScrollViewer>
					<Button
						Grid.Row="1"
						Classes="settings-btn"
						Command="{Binding OpenSettingsCommand}"
						ToolTip.Tip="Settings">
						<StackPanel Orientation="Horizontal" Spacing="7">
							<PathIcon Data="{StaticResource IconCog}" Width="{DynamicResource IconMedium}" Height="{DynamicResource IconMedium}" />
							<TextBlock Text="Settings" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</Grid>
			</Border>

		<!--  drag to resize the sidebar  -->
		<GridSplitter
			Grid.Column="1"
			Background="Transparent"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Columns"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch" />

		<Grid Grid.Column="2" Margin="10,10,10,10">
				<!--  rounded main-area card: floats on the dark chrome; the content grid
				      above it stays transparent so the corners read through  -->
				<Border CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0" />
				<Grid RowDefinitions="*">

					<!--  Tile grid: every open chat is one tile  -->
					<Grid Margin="0,8,0,0">
						<ItemsControl ItemsSource="{Binding OpenTiles}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="{Binding TileColumns}" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<v:ChatTile Margin="4" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsVisible="{Binding !HasTiles}">
							<PathIcon
								Data="{StaticResource IconSpark}"
								Width="56"
								Height="56"
								Foreground="{DynamicResource TextMutedBrush}"
								HorizontalAlignment="Center"
								Margin="0,0,0,16" />
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasNoWorkspace}"
								Text="Add a workspace folder to begin." />
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasIdleWorkspace}"
								Text="Start the server to load your chats." />
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasRunningWorkspace}"
							Text="Open a chat from the sidebar, or start a new one with the + next to a workspace." />
						</StackPanel>

						<!--  relaunch offer: the last session left chats tiled  -->
						<Border
							Classes="restore-bar"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							Margin="0,12,0,0"
							IsVisible="{Binding ShowRestorePrompt}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<PathIcon
									Data="{StaticResource IconClock}"
									Width="{DynamicResource IconMedium}"
									Height="{DynamicResource IconMedium}"
									Foreground="{DynamicResource TextMutedBrush}"
									VerticalAlignment="Center" />
								<TextBlock Text="{Binding RestorePromptText}" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								<Button Classes="btn-soft" Command="{Binding RestorePreviousSessionCommand}" ToolTip.Tip="Reopen the chats from the last session">
									<TextBlock Text="Restore" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								</Button>
								<Button Classes="btn-soft" Command="{Binding DismissRestorePromptCommand}" ToolTip.Tip="Discard the saved tile list">
									<TextBlock Text="Ignore" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								</Button>
							</StackPanel>
						</Border>

							<!--  Settings page: covers the tile grid while open (same cell, later
							      child = on top; Row 1 would fall into an implicit row and leak
							      the tile grid above it)  -->
							<Border
								Margin="0,8,0,0"
								CornerRadius="12"
								Background="{DynamicResource SurfaceBrush}"
								IsVisible="{Binding IsSettingsOpen}">
							<ScrollViewer HorizontalScrollBarVisibility="Disabled">
								<StackPanel
									Margin="28,24"
									MaxWidth="620"
									HorizontalAlignment="Left"
									Spacing="18"
									DataContext="{Binding SettingsPage}"
									x:DataType="vm:SettingsPageViewModel">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock
											Text="Settings"
											FontSize="{DynamicResource FontTitle}"
											FontWeight="SemiBold"
											VerticalAlignment="Center" />
										<Button
											Grid.Column="1"
											Classes="btn-soft"
											Command="{Binding $parent[Window].DataContext.CloseSettingsCommand}"
											ToolTip.Tip="Close without saving">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
												<TextBlock Text="Back" VerticalAlignment="Center" />
											</StackPanel>
										</Button>
									</Grid>

									<!--  server  -->
									<StackPanel Spacing="6">
										<TextBlock Classes="settings-section" Text="Server" />
										<Border Classes="settings-card">
											<StackPanel Spacing="8">
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="OpenCode executable" />
													<TextBox
														Grid.Column="1"
														Text="{Binding OpenCodeExecutable}"
														PlaceholderText="opencode"
														ToolTip.Tip="Binary name (resolved on PATH) or full path to the opencode executable" />
												</Grid>
												<TextBlock Classes="settings-hint" Text="Running servers keep their current binary until stopped and started again." />
											</StackPanel>
										</Border>
									</StackPanel>

									<!--  chat defaults  -->
									<StackPanel Spacing="6">
										<TextBlock Classes="settings-section" Text="Chat defaults" />
										<Border Classes="settings-card">
											<StackPanel Spacing="10">
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="Model" />
													<TextBox Grid.Column="1" Text="{Binding DefaultModel}" PlaceholderText="provider/model-id — empty = server default" />
												</Grid>
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="Variant" />
													<TextBox Grid.Column="1" Text="{Binding DefaultVariant}" PlaceholderText="empty = model default" />
												</Grid>
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="Agent" />
													<TextBox Grid.Column="1" Text="{Binding DefaultAgent}" PlaceholderText="empty = default build" />
												</Grid>
											</StackPanel>
										</Border>
									</StackPanel>

									<!--  appearance  -->
									<StackPanel Spacing="6">
										<TextBlock Classes="settings-section" Text="Appearance" />
										<Border Classes="settings-card">
											<StackPanel Spacing="12">
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="Text size" />
													<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
														<RadioButton GroupName="TextSize" Content="Small" IsChecked="{Binding IsTextCompact}" />
														<RadioButton GroupName="TextSize" Content="Normal" IsChecked="{Binding IsTextNormal}" />
														<RadioButton GroupName="TextSize" Content="Large" IsChecked="{Binding IsTextLarge}" />
													</StackPanel>
												</Grid>
												<TextBlock Classes="settings-hint" Margin="160,0,0,0" Text="Applied across the app as soon as it's saved." />
												<Border Height="1" Background="{DynamicResource HairlineBrush}" />
												<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
													<TextBlock Classes="settings-label" Text="Accent" />
													<ItemsControl Grid.Column="1" ItemsSource="{Binding AccentOptions}">
														<ItemsControl.ItemsPanel>
															<ItemsPanelTemplate>
																<StackPanel Orientation="Horizontal" Spacing="10" />
															</ItemsPanelTemplate>
														</ItemsControl.ItemsPanel>
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<RadioButton
																	Classes="accent-swatch"
																	GroupName="Accent"
																	IsChecked="{Binding IsSelected, Mode=TwoWay}"
																	ToolTip.Tip="{Binding Label}" />
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Grid>
												<TextBlock Classes="settings-hint" Margin="160,0,0,0" Text="Green, amber, salmon and three gray tones; recolors selected states, focus ring and success dots." />
											</StackPanel>
										</Border>
									</StackPanel>

									<!--  permissions  -->
									<StackPanel Spacing="6">
										<TextBlock Classes="settings-section" Text="Permissions" />
										<Border Classes="settings-card">
											<StackPanel Spacing="12">
												<CheckBox IsChecked="{Binding AutoAllow}" Content="Always allow tool permissions (edit, bash, webfetch)" />
												<StackPanel Spacing="10" IsVisible="{Binding AutoAllow}">
													<Border Height="1" Background="{DynamicResource HairlineBrush}" />
													<TextBlock Classes="settings-label" FontWeight="SemiBold" Text="Auto-allow delay" />
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Working hours" />
														<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<TextBox Width="64" Text="{Binding AutoAllowDefaultMin}" ToolTip.Tip="Minimum random wait" />
															<TextBlock Text="–" VerticalAlignment="Center" Opacity="0.8" />
															<TextBox Width="64" Text="{Binding AutoAllowDefaultMax}" ToolTip.Tip="Maximum random wait" />
															<TextBlock Text="seconds" VerticalAlignment="Center" Opacity="0.5" FontStyle="Italic" FontSize="{DynamicResource FontSmall}" />
														</StackPanel>
													</Grid>
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Lunch" />
														<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<TextBox Width="40" Text="{Binding LunchStartHour}" ToolTip.Tip="Lunch start hour" />
															<TextBlock Text="–" VerticalAlignment="Center" Opacity="0.8" />
															<TextBox Width="40" Text="{Binding LunchEndHour}" ToolTip.Tip="Lunch end hour" />
															<TextBlock Text="→" VerticalAlignment="Center" Opacity="0.8" />
															<TextBox Width="64" Text="{Binding AutoAllowAwayMin}" ToolTip.Tip="Minimum random wait" />
															<TextBlock Text="–" VerticalAlignment="Center" Opacity="0.8" />
															<TextBox Width="64" Text="{Binding AutoAllowAwayMax}" ToolTip.Tip="Maximum random wait" />
														</StackPanel>
													</Grid>
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Off hours" />
														<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
															<TextBox Width="40" Text="{Binding OffHoursStartHour}" ToolTip.Tip="Off-hours start hour" />
															<TextBlock Text="→" VerticalAlignment="Center" Opacity="0.8" />
															<TextBox Width="40" Text="{Binding WorkdayStartHour}" ToolTip.Tip="Workday start hour next morning" />
															<TextBlock Text="→" VerticalAlignment="Center" Opacity="0.8" />
															<TextBlock Text="same range as lunch" VerticalAlignment="Center" Opacity="0.6" FontStyle="Italic" />
														</StackPanel>
													</Grid>
													<TextBlock Classes="settings-hint" Text="Random wait before auto-allow, picked by local time: working hours use the short range, lunch and off hours the long one." />
												</StackPanel>
											</StackPanel>
										</Border>
									</StackPanel>

									<Button Classes="btn-soft" HorizontalAlignment="Left" Command="{Binding SaveCommand}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Data="{StaticResource IconCheck}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
											<TextBlock Text="Save" VerticalAlignment="Center" />
										</StackPanel>
									</Button>
								</StackPanel>
							</ScrollViewer>
						</Border>
					</Grid>
				</Grid>
			</Grid>
			<!--  error overlay: CrashGuard's last-ditch dialog. An error never takes the app
			      down — this explains what failed and hands the full report to the clipboard  -->
			<Border
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Background="#A6000000"
				IsVisible="{Binding Error.IsVisible}">
				<Border
					Classes="error-dialog"
					MaxWidth="560"
					Margin="24"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<PathIcon
								Data="{StaticResource IconWarn}"
								Width="{DynamicResource IconLarge}"
								Height="{DynamicResource IconLarge}"
								Foreground="{DynamicResource DangerBrush}"
								VerticalAlignment="Top" />
							<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
								<TextBlock Text="Something went wrong" FontSize="{DynamicResource FontBodyLarge}" FontWeight="SemiBold" />
								<TextBlock Classes="error-sub" Text="{Binding Error.Source}" />
							</StackPanel>
							<Button
								Grid.Column="2"
								Classes="icon"
								Click="OnCloseErrorClick"
								ToolTip.Tip="Dismiss">
								<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
							</Button>
						</Grid>
						<TextBlock
							Classes="error-sub"
							Foreground="{DynamicResource DangerBrush}"
							TextWrapping="Wrap"
							IsVisible="{Binding Error.IsFatal}"
							Text="This error is fatal — the app closes when you continue." />
						<TextBlock
							FontSize="{DynamicResource FontBody}"
							TextWrapping="Wrap"
							Text="{Binding Error.ErrorMessage}" />
						<Border Classes="error-detail">
							<ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
								<TextBlock Classes="error-mono" Text="{Binding Error.ErrorDetails}" />
							</ScrollViewer>
						</Border>
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock
								Classes="error-sub"
								VerticalAlignment="Center"
								IsVisible="{Binding Error.HasMore}"
								Text="{Binding Error.MoreCount, StringFormat='+{0} more waiting'}" />
							<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
								<Button Classes="btn-soft" Click="OnCopyErrorClick" ToolTip.Tip="Copy the full report">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<PathIcon Data="{StaticResource IconCopy}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
										<TextBlock Text="Copy details" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button Classes="btn-soft" Click="OnCloseErrorClick" ToolTip.Tip="Keep going">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<PathIcon Data="{StaticResource IconCheck}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
										<TextBlock Text="Continue" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
			</Border>
		</Grid>
	</suki:SukiWindow>
