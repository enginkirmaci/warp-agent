<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="WarpAgent.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:WarpAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:v="using:WarpAgent.Views"
	xmlns:vm="using:WarpAgent.ViewModels"
	Title="Warp Agent"
	Icon="avares://WarpAgent/Assets/spark.png"
	Width="1180"
	Height="800"
	MinWidth="860"
	MinHeight="580"
	BackgroundStyle="Flat"
	BackgroundAnimationEnabled="False"
	WindowStartupLocation="CenterScreen"
	x:DataType="vm:MainViewModel"
	mc:Ignorable="d">

	<suki:SukiWindow.LogoContent>
		<PathIcon Data="{StaticResource IconSpark}" Width="15" Height="15" Foreground="{DynamicResource TextMutedBrush}" />
	</suki:SukiWindow.LogoContent>

	<suki:SukiWindow.Styles>
		<!--  flatten the titlebar too: the SukiUI shader (waves/gradient) must never show  -->
		<Style Selector="suki|SukiWindow /template/ Border#PART_TitleBarBackground">
			<Setter Property="Background" Value="{DynamicResource WindowChromeBrush}" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="{DynamicResource SuccessDimBrush}" />
		</Style>
		<Style Selector="TextBlock.sidebar-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,8" />
		</Style>

		<!--  sidebar rows draw their own hover + selection; SukiUI's check badge and
		      selected tint are suppressed — selection is the accent border only  -->
		<Style Selector="Border.row-card">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<!--  the focused chat's row keeps a soft accent tint; hover still wins while pointing  -->
		<Style Selector="Border.row-card.selected">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
		</Style>
		<Style Selector="Border.row-card:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  workspace row actions appear on hover only  -->
		<Style Selector="Button.ws-action">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Border.row-card:pointerover Button.ws-action">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<!--  the Workspaces header's + behaves the same: hidden until the header is hovered  -->
		<Style Selector="Grid.projects-header Button.ws-action">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Grid.projects-header:pointerover Button.ws-action">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<!--  collapse chevron: compact square so it fits the sidebar row  -->
		<Style Selector="Button.chevron">
			<Setter Property="Width" Value="20" />
			<Setter Property="Height" Value="20" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>
		<Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="TextBlock.task-done">
			<Setter Property="TextDecorations" Value="Strikethrough" />
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!--  buttons  -->
		<Style Selector="Button.btn-soft">
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.btn-soft:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  relaunch banner: flat hairline chip floating at the top of the tile grid  -->
		<Style Selector="Border.restore-bar">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="14,7" />
		</Style>
		<Style Selector="Border.restore-bar Button.btn-soft">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Padding" Value="12,3" />
		</Style>

		<!--  sidebar resize handle: invisible until hovered  -->
		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="GridSplitter:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<!--  error overlay: the crash-guard dialog shown over everything  -->
		<Style Selector="Border.error-dialog">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="18" />
		</Style>
		<Style Selector="Border.error-detail">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10" />
		</Style>
		<Style Selector="TextBlock.error-sub">
			<Setter Property="FontSize" Value="{DynamicResource FontXSmall}" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="TextBlock.error-mono">
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="{DynamicResource FontDetail}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--  painted root: solid flat canvas over the SukiUI shader — no gradient, no waves.
	      the sidebar column shows WindowChromeBrush (same solid as the titlebar); the
	      tile grid paints the darker SurfaceBrush on top of it  -->
	<Grid x:Name="LayoutRoot" Background="{DynamicResource WindowChromeBrush}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="4" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  Sidebar: workspaces + their chats  -->
		<Border
			Grid.Column="0"
			MinWidth="180"
			MaxWidth="480"
			Margin="10,10,0,10"
			Padding="10">
				<Grid RowDefinitions="*,Auto">
					<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
						<!--  explicit viewport width: the ScrollViewer's own horizontal measure goes
						      stale across splitter drags, leaving the rows shifted/overflowing  -->
						<StackPanel Width="{Binding $parent[ScrollViewer].Viewport.Width}" Spacing="10">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Classes="projects-header">
								<TextBlock
									Text="Workspaces"
									FontSize="{DynamicResource FontSmall}"
									FontWeight="SemiBold"
									Opacity="0.7"
									VerticalAlignment="Center" />
								<Button
									Grid.Column="1"
									Classes="icon ws-action"
									Click="OnAddWorkspaceClicked"
									ToolTip.Tip="Add workspace folder">
									<PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" />
								</Button>
							</Grid>
							<ItemsControl ItemsSource="{Binding Workspaces}">
								<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,1">
											<Border
												Classes="row-card"
												ToolTip.Tip="{Binding FolderPath}"
												Tapped="OnWorkspaceClick">
													<Border.ContextMenu>
														<ContextMenu>
															<MenuItem Header="Start server" Click="OnWorkspaceStartClick" IsVisible="{Binding !IsRunning}" />
															<MenuItem Header="Stop server" Click="OnWorkspaceStopClick" IsVisible="{Binding IsRunning}" />
															<MenuItem Header="Remove workspace" Click="OnWorkspaceRemoveClick" />
														</ContextMenu>
													</Border.ContextMenu>
													<Grid ColumnDefinitions="Auto,*,Auto">
														<Button
															Classes="icon chevron"
															Click="OnWorkspaceCollapseClick"
															ToolTip.Tip="Collapse / expand chats">
															<Panel>
																<PathIcon
																	Data="{StaticResource IconChevronDown}"
																	Width="11"
																	Height="11"
																	IsVisible="{Binding IsExpanded}" />
																<PathIcon
																	Data="{StaticResource IconChevronRight}"
																	Width="11"
																	Height="11"
																	IsVisible="{Binding !IsExpanded}" />
															</Panel>
														</Button>
														<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" Margin="4,0,0,0">
															<PathIcon
																Data="{StaticResource IconFolderOutline}"
																Width="13"
																Height="13"
																Foreground="{DynamicResource TextMutedBrush}"
																VerticalAlignment="Center" />
															<TextBlock
																Text="{Binding Name}"
																TextTrimming="CharacterEllipsis"
																FontSize="{DynamicResource FontBody}"
																VerticalAlignment="Center" />
															<Ellipse
																Width="6"
																Height="6"
																Fill="{DynamicResource SuccessBrush}"
																VerticalAlignment="Center"
																IsVisible="{Binding IsRunning}" />
														</StackPanel>
														<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
															<Button
																Classes="icon ws-action"
																Click="OnWorkspaceMenuClick"
																ToolTip.Tip="Workspace actions">
																<PathIcon Data="{StaticResource IconKebab}" Width="13" Height="13" />
															</Button>
															<Button
																Classes="icon ws-action"
																Command="{Binding $parent[ItemsControl].DataContext.NewChatForWorkspaceCommand}"
																CommandParameter="{Binding}"
																ToolTip.Tip="New chat in this workspace">
																<PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" />
															</Button>
														</StackPanel>
													</Grid>
												</Border>
											<StackPanel IsVisible="{Binding IsExpanded}">
												<TextBlock
													Classes="sidebar-hint"
													Margin="26,1,0,1"
													HorizontalAlignment="Left"
													TextAlignment="Left"
													IsVisible="{Binding ShowEmptyHint}"
													Text="No chats yet" />
												<ItemsControl ItemsSource="{Binding Chats}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border
															Classes="row-card"
															Classes.selected="{Binding IsSelected}"
															Margin="22,0,0,0"
															ToolTip.Tip="{Binding Title}"
															Tapped="OnSessionClick">
															<Border.ContextMenu>
																<ContextMenu>
																	<MenuItem Header="Pin" Click="OnPinClick" IsVisible="{Binding !IsPinned}" />
																	<MenuItem Header="Unpin" Click="OnUnpinClick" IsVisible="{Binding IsPinned}" />
																	<MenuItem Header="Rename" Click="OnRenameClick" />
																	<MenuItem Header="Copy share link" Click="OnShareClick" />
																	<MenuItem Header="Stop sharing" Click="OnUnshareClick" />
																	<MenuItem Header="Remove from workspace" Click="OnUnlinkClick" />
																	<MenuItem Header="Delete" Click="OnDeleteClick" />
																</ContextMenu>
															</Border.ContextMenu>
															<Grid ColumnDefinitions="13,*,Auto" ColumnSpacing="5">
																<!--  gutter: spinner while the turn runs, pin otherwise —
																      titles stay aligned across all chat rows  -->
																<Panel VerticalAlignment="Center">
																	<PathIcon
																		Classes="spin"
																		Data="{StaticResource IconSpinner}"
																		Width="12"
																		Height="12"
																		IsVisible="{Binding IsRunning}" />
																	<PathIcon
																		Data="{StaticResource IconPin}"
																		Width="11"
																		Height="11"
																		Foreground="{DynamicResource TextMutedBrush}"
																		VerticalAlignment="Center"
																		IsVisible="{Binding PinVisible}" />
																</Panel>
																<TextBlock
																	Grid.Column="1"
																	Text="{Binding Title}"
																	TextTrimming="CharacterEllipsis"
																	FontSize="{DynamicResource FontBody}"
																	VerticalAlignment="Center"
																	IsVisible="{Binding !IsEditing}" />
																<TextBox
																	Grid.Column="1"
																	Text="{Binding DraftTitle}"
																	IsVisible="{Binding IsEditing}"
																	KeyDown="OnRenameKeyDown"
																	LostFocus="OnRenameLostFocus" />
																<TextBlock
																	Grid.Column="2"
																	Text="{Binding UpdatedLabel}"
																	FontSize="{DynamicResource FontMicro}"
																	Opacity="0.45"
																	VerticalAlignment="Center"
																	IsVisible="{Binding !IsEditing}" />
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
												</ItemsControl>
											</StackPanel>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasNoWorkspace}"
								Text="Add a workspace folder to begin." />
						</StackPanel>
					</ScrollViewer>
					<Button
						Grid.Row="1"
						Classes="icon"
						HorizontalAlignment="Left"
						Command="{Binding OpenSettingsCommand}"
						ToolTip.Tip="Settings">
						<PathIcon Data="{StaticResource IconCog}" Width="14" Height="14" />
					</Button>
				</Grid>
			</Border>

		<!--  drag to resize the sidebar  -->
		<GridSplitter
			Grid.Column="1"
			Background="Transparent"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Columns"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch" />

		<Grid Grid.Column="2" Margin="10,10,10,10" Background="{DynamicResource SurfaceBrush}">
				<Grid RowDefinitions="*">

					<!--  Tile grid: every open chat is one tile  -->
					<Grid Margin="0,8,0,0">
						<ItemsControl ItemsSource="{Binding OpenTiles}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<UniformGrid Columns="{Binding TileColumns}" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<v:ChatTile Margin="4" />
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<StackPanel
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							IsVisible="{Binding !HasTiles}">
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasNoWorkspace}"
								Text="Add a workspace folder to begin." />
							<TextBlock
								Classes="sidebar-hint"
								IsVisible="{Binding HasIdleWorkspace}"
								Text="Start the server to load your chats." />
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasRunningWorkspace}"
							Text="Open a chat from the sidebar, or start a new one with the + next to a workspace." />
						</StackPanel>

						<!--  relaunch offer: the last session left chats tiled  -->
						<Border
							Classes="restore-bar"
							HorizontalAlignment="Center"
							VerticalAlignment="Top"
							Margin="0,12,0,0"
							IsVisible="{Binding ShowRestorePrompt}">
							<StackPanel Orientation="Horizontal" Spacing="12">
								<PathIcon
									Data="{StaticResource IconClock}"
									Width="14"
									Height="14"
									Foreground="{DynamicResource TextMutedBrush}"
									VerticalAlignment="Center" />
								<TextBlock Text="{Binding RestorePromptText}" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								<Button Classes="btn-soft" Command="{Binding RestorePreviousSessionCommand}" ToolTip.Tip="Reopen the chats from the last session">
									<TextBlock Text="Restore" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								</Button>
								<Button Classes="btn-soft" Command="{Binding DismissRestorePromptCommand}" ToolTip.Tip="Discard the saved tile list">
									<TextBlock Text="Ignore" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
								</Button>
							</StackPanel>
						</Border>

						<!--  Settings page: covers the tile grid while open  -->
						<Border
							Grid.Row="1"
							Margin="0,8,0,0"
							CornerRadius="12"
							Background="{DynamicResource SurfaceBrush}"
							IsVisible="{Binding IsSettingsOpen}">
							<ScrollViewer HorizontalScrollBarVisibility="Disabled">
								<StackPanel
									Margin="28,24"
									MaxWidth="620"
									HorizontalAlignment="Left"
									Spacing="16"
									DataContext="{Binding SettingsPage}"
									x:DataType="vm:SettingsPageViewModel">
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock
											Text="Settings"
											FontSize="{DynamicResource FontTitle}"
											FontWeight="SemiBold"
											VerticalAlignment="Center" />
										<Button
											Grid.Column="1"
											Classes="btn-soft"
											Command="{Binding $parent[Window].DataContext.CloseSettingsCommand}"
											ToolTip.Tip="Close without saving">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
												<TextBlock Text="Back" VerticalAlignment="Center" />
											</StackPanel>
										</Button>
									</Grid>

									<StackPanel Spacing="4">
										<TextBlock Text="OpenCode executable" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" />
										<TextBox
											Text="{Binding OpenCodeExecutable}"
											PlaceholderText="opencode"
											ToolTip.Tip="Binary name (resolved on PATH) or full path to the opencode executable" />
										<TextBlock
											Classes="sidebar-hint"
											HorizontalAlignment="Left"
											Text="Running servers keep their current binary until stopped and started again." />
									</StackPanel>

									<StackPanel Spacing="4">
										<TextBlock Text="Default model" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" />
										<TextBox Text="{Binding DefaultModel}" PlaceholderText="provider/model-id — empty = server default" />
									</StackPanel>
									<StackPanel Spacing="4">
										<TextBlock Text="Default variant" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" />
										<TextBox Text="{Binding DefaultVariant}" PlaceholderText="empty = model default" />
									</StackPanel>
									<StackPanel Spacing="4">
										<TextBlock Text="Default agent" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" />
										<TextBox Text="{Binding DefaultAgent}" PlaceholderText="empty = default build" />
									</StackPanel>

									<StackPanel Spacing="4">
										<TextBlock Text="Text size" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" />
										<StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
											<RadioButton GroupName="TextSize" Content="Small" IsChecked="{Binding IsTextCompact}" />
											<RadioButton GroupName="TextSize" Content="Normal" IsChecked="{Binding IsTextNormal}" />
											<RadioButton GroupName="TextSize" Content="Large" IsChecked="{Binding IsTextLarge}" />
										</StackPanel>
										<TextBlock
											Classes="sidebar-hint"
											HorizontalAlignment="Left"
											Text="Applied across the app as soon as it's saved." />
									</StackPanel>

									<CheckBox IsChecked="{Binding AutoAllow}" Content="Always allow tool permissions (edit, bash, webfetch)" />

									<Button Classes="btn-soft" HorizontalAlignment="Left" Command="{Binding SaveCommand}">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" />
											<TextBlock Text="Save" VerticalAlignment="Center" />
										</StackPanel>
									</Button>
								</StackPanel>
							</ScrollViewer>
						</Border>
					</Grid>
				</Grid>
			</Grid>
			<!--  error overlay: CrashGuard's last-ditch dialog. An error never takes the app
			      down — this explains what failed and hands the full report to the clipboard  -->
			<Border
				Grid.Column="0"
				Grid.ColumnSpan="3"
				Background="#A6000000"
				IsVisible="{Binding Error.IsVisible}">
				<Border
					Classes="error-dialog"
					MaxWidth="560"
					Margin="24"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<PathIcon
								Data="{StaticResource IconWarn}"
								Width="15"
								Height="15"
								Foreground="{DynamicResource DangerBrush}"
								VerticalAlignment="Top" />
							<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
								<TextBlock Text="Something went wrong" FontSize="{DynamicResource FontBodyLarge}" FontWeight="SemiBold" />
								<TextBlock Classes="error-sub" Text="{Binding Error.Source}" />
							</StackPanel>
							<Button
								Grid.Column="2"
								Classes="icon"
								Click="OnCloseErrorClick"
								ToolTip.Tip="Dismiss">
								<PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
							</Button>
						</Grid>
						<TextBlock
							Classes="error-sub"
							Foreground="{DynamicResource DangerBrush}"
							TextWrapping="Wrap"
							IsVisible="{Binding Error.IsFatal}"
							Text="This error is fatal — the app closes when you continue." />
						<TextBlock
							FontSize="{DynamicResource FontBody}"
							TextWrapping="Wrap"
							Text="{Binding Error.ErrorMessage}" />
						<Border Classes="error-detail">
							<ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
								<TextBlock Classes="error-mono" Text="{Binding Error.ErrorDetails}" />
							</ScrollViewer>
						</Border>
						<Grid ColumnDefinitions="Auto,*">
							<TextBlock
								Classes="error-sub"
								VerticalAlignment="Center"
								IsVisible="{Binding Error.HasMore}"
								Text="{Binding Error.MoreCount, StringFormat='+{0} more waiting'}" />
							<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
								<Button Classes="btn-soft" Click="OnCopyErrorClick" ToolTip.Tip="Copy the full report">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<PathIcon Data="{StaticResource IconCopy}" Width="11" Height="11" />
										<TextBlock Text="Copy details" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button Classes="btn-soft" Click="OnCloseErrorClick" ToolTip.Tip="Keep going">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<PathIcon Data="{StaticResource IconCheck}" Width="11" Height="11" />
										<TextBlock Text="Continue" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>
			</Border>
		</Grid>
	</suki:SukiWindow>
