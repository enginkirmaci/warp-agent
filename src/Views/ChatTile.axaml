<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="WarpAgent.Views.ChatTile"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:WarpAgent.Controls"
	xmlns:mk="using:MarkdownViewerKit"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:m="using:WarpAgent.Models"
	xmlns:vm="using:WarpAgent.ViewModels"
	x:DataType="vm:ChatTileViewModel"
	mc:Ignorable="d">

	<UserControl.Styles>
		<Style Selector="Border.tile-root">
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.tile-root.focused">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>

		<Style Selector="TextBlock.note">
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,3" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.tool-error">
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
			<Setter Property="FontSize" Value="11.5" />
		</Style>
		<Style Selector="TextBlock.mono-detail">
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="11.5" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>
		<Style Selector="TextBlock.msg-time">
			<Setter Property="FontSize" Value="10.5" />
			<Setter Property="Opacity" Value="0.55" />
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<!--  completed checklist rows read muted  -->
		<Style Selector="TextBlock.task-done">
			<Setter Property="Opacity" Value="0.5" />
		</Style>

		<!--  hover-revealed copy on message bubbles — bare glyph, no button chrome  -->
		<Style Selector="Button.msg-copy">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="3" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="MinWidth" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Border.msg-surface:pointerover Button.msg-copy">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--  markdown code-block copy affordance  -->
		<Style Selector="Button.code-copy">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="3" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="MinWidth" Value="0" />
		</Style>
		<Style Selector="Border.code-block:pointerover Button.code-copy">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<!--  queue row steer pill  -->
		<Style Selector="Button.queue-steer">
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="Padding" Value="9,4" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="MinHeight" Value="26" />
		</Style>
		<Style Selector="Button.queue-steer:pointerover">
			<Setter Property="Background" Value="{DynamicResource QueuedBorderBrush}" />
		</Style>

		<!--  status dots — color only, no motion  -->
		<Style Selector="Ellipse.tool-dot">
			<Setter Property="Width" Value="7" />
			<Setter Property="Height" Value="7" />
			<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Ellipse.tool-dot.running">
			<Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="Ellipse.tool-dot.completed">
			<!--  muted on purpose: running owns the green dot, error owns red  -->
			<Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="Ellipse.tool-dot.error">
			<Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
		</Style>

		<!--  buttons — no color fill; muted glyphs that tint on hover  -->
		<Style Selector="Button.btn-send">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="Button.btn-send:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="Button.btn-stop">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="Button.btn-stop:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		</Style>

		<!--  flat composer pills (model / variant / agent) — bare text + chevron, same 34px height as send/stop  -->
		<Style Selector="Button.composer-pill">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="7,4" />
			<Setter Property="Height" Value="34" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.composer-pill:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>

		<!--  attach affordance: bare doc icon beside the auto-allow toggle, no button chrome  -->
		<Style Selector="Button.attach-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="4" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.attach-btn:pointerover">
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style Selector="Button.btn-allow">
			<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="Button.btn-soft-accent">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.btn-deny">
			<Setter Property="Background" Value="{DynamicResource DangerDimBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="FontSize" Value="12" />
		</Style>
		<Style Selector="Button.jump-btn">
			<Setter Property="Background" Value="{DynamicResource ChipBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Padding" Value="11,6" />
			<Setter Property="FontSize" Value="12" />
		</Style>

		<!--  error notes surface as a red section — same card family as permission asks  -->
		<Style Selector="Border.error-card">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="MaxWidth" Value="640" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Background" Value="{DynamicResource DangerDimBrush}" />
			<Setter Property="Margin" Value="0,3" />
		</Style>

		<!--  tasks expander: always visible so the flyout is discoverable  -->

		<!--  composer focus ring  -->
		<Style Selector="Border.input-card">
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.input-card:focus-within">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		</Style>

		<!--  auto-allow on/off toggle: bare glyph, no chrome; filled shield when active  -->
		<Style Selector="ToggleButton.allow-toggle">
			<Setter Property="Padding" Value="7" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<!--  checked reads warm: filled amber shield, no fill behind.
		      :checked, not :on — Avalonia's ToggleButton has no :on pseudo-class  -->
		<Style Selector="ToggleButton.allow-toggle:checked">
			<Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
		</Style>

		<!--  question ask card: neutral bubble, options tint on hover and when picked  -->
		<Style Selector="Border.q-card">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Background" Value="{DynamicResource BubbleAssistantBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="MaxWidth" Value="640" />
			<Setter Property="Margin" Value="0,4,40,4" />
		</Style>
		<Style Selector="Button.q-opt">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="9,6" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Button.q-opt:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Button.q-opt.selected">
			<Setter Property="Background" Value="{DynamicResource QOptSelectedBrush}" />
		</Style>
		<Style Selector="TextBox.q-custom">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="MinHeight" Value="0" />
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</UserControl.Styles>

	<Border
		Classes="tile-root"
		Classes.focused="{Binding IsFocused}"
		Tapped="OnTileTapped">
		<Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

			<!--  tile header: close action left of the identity (pulse + title), meta at the right  -->
			<Grid Grid.Row="0" Margin="10,7,7,0" ColumnDefinitions="Auto,Auto,Auto,*">
				<Button
					Grid.Column="0"
					Classes="icon"
					Margin="0,0,2,0"
					Command="{Binding CloseCommand}"
					ToolTip.Tip="Close this tile — the chat stays in the sidebar and keeps running">
					<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
				</Button>
				<Ellipse Grid.Column="1" Classes="pulse" Margin="4,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
				<TextBlock
					Grid.Column="2"
					Text="{Binding Title}"
					Margin="7,0,0,0"
					FontSize="{DynamicResource FontBody}"
					FontWeight="SemiBold"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					ToolTip.Tip="{Binding Title}" />
				<!--  corner details: next model/variant plus the conversation's total context usage  -->
				<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
					<TextBlock
						Text="{Binding SelectedModel}"
						FontSize="{DynamicResource FontMicro}"
						Opacity="0.5"
						MaxWidth="220"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						ToolTip.Tip="{Binding SelectedModel}" />
					<TextBlock Text="·" FontSize="{DynamicResource FontMicro}" Opacity="0.3" VerticalAlignment="Center" />
					<TextBlock
						Text="{Binding SelectedVariant}"
						FontSize="{DynamicResource FontMicro}"
						Opacity="0.5"
						MaxWidth="120"
						TextTrimming="CharacterEllipsis"
						VerticalAlignment="Center"
						ToolTip.Tip="{Binding SelectedVariant}" />
					<TextBlock Text="·" FontSize="{DynamicResource FontMicro}" Opacity="0.3" VerticalAlignment="Center" IsVisible="{Binding HasContext}" />
					<TextBlock
						Text="{Binding ContextText}"
						FontSize="{DynamicResource FontMicro}"
						Opacity="0.5"
						VerticalAlignment="Center"
						IsVisible="{Binding HasContext}"
						ToolTip.Tip="Total tokens used by this conversation vs the model's context limit" />
					<!--  tasks expander: lives beside the context stats, always visible  -->
					<Panel Margin="2,0,0,0" IsVisible="{Binding HasTasksOrAgents}">
						<Button
							x:Name="TasksButton"
							Classes="icon tasks-btn"
							Click="OnTasksButtonClick"
							ToolTip.Tip="Tasks and running agents">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<PathIcon
									Data="{StaticResource IconWarn}"
									Width="{DynamicResource IconXSmall}"
									Height="{DynamicResource IconXSmall}"
									Foreground="{DynamicResource WarnBrush}"
									VerticalAlignment="Center"
									IsVisible="{Binding Owner.HasAttentionNeeded}"
									ToolTip.Tip="An agent is waiting for a permission answer" />
								<PathIcon
									Data="{StaticResource IconExpand}"
									Width="{DynamicResource IconXSmall}"
									Height="{DynamicResource IconXSmall}"
									VerticalAlignment="Center" />
							</StackPanel>
						</Button>
							<Popup
								x:Name="TasksPopup"
								PlacementTarget="{Binding #TasksButton}"
								Placement="BottomEdgeAlignedRight"
								IsLightDismissEnabled="False">
								<Border
									MinWidth="300"
									MaxWidth="440"
									CornerRadius="12"
									Background="{DynamicResource FlyoutSurfaceBrush}"
									BorderBrush="{DynamicResource HairlineBrush}"
									BorderThickness="1"
									Padding="12,10"
									TextElement.Foreground="{DynamicResource TextBrush}">
								<ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
									<StackPanel Spacing="8">
										<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTasks}">
											<TextBlock Text="Progress" FontWeight="SemiBold" FontSize="{DynamicResource FontBodyLarge}" Margin="2,0,0,0" VerticalAlignment="Center" />
											<TextBlock Grid.Column="1" Text="{Binding TasksProgress}" FontSize="{DynamicResource FontDetail}" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
										</Grid>
										<ItemsControl ItemsSource="{Binding Tasks}" IsVisible="{Binding HasTasks}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Grid ColumnDefinitions="14,*" Margin="2,4">
														<PathIcon
															Data="{StaticResource IconCircleCheck}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource SuccessBrush}"
															VerticalAlignment="Top"
															Margin="0,2,0,0"
															IsVisible="{Binding Completed}" />
														<PathIcon
															Data="{StaticResource IconPlay}"
															Width="{DynamicResource IconXSmall}"
															Height="{DynamicResource IconXSmall}"
															Foreground="{DynamicResource AccentBrush}"
															VerticalAlignment="Top"
															Margin="1,3,0,0"
															IsVisible="{Binding InProgress}" />
														<PathIcon
															Data="{StaticResource IconCircle}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource TextMutedBrush}"
															VerticalAlignment="Top"
															Margin="0,2,0,0"
															IsVisible="{Binding Pending}" />
														<PathIcon
															Data="{StaticResource IconDash}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource TextMutedBrush}"
															VerticalAlignment="Top"
															Margin="0,2,0,0"
															IsVisible="{Binding Cancelled}" />
														<TextBlock
															Grid.Column="1"
															Text="{Binding Content}"
															TextWrapping="Wrap"
															FontSize="{DynamicResource FontBody}"
															Margin="7,1,0,0"
															Classes.task-done="{Binding Done}" />
													</Grid>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
										<Border Height="1" Background="{DynamicResource HairlineBrush}" Margin="0,3" IsVisible="{Binding HasTasksAndAgents}" />
										<Grid ColumnDefinitions="*,Auto" IsVisible="{Binding Owner.HasBackgroundAgents}">
											<TextBlock Text="Agents" FontWeight="SemiBold" FontSize="{DynamicResource FontBodyLarge}" Margin="2,0,0,0" VerticalAlignment="Center" />
											<TextBlock Grid.Column="1" Text="{Binding Owner.AgentsSummary}" FontSize="{DynamicResource FontDetail}" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
										</Grid>
										<ItemsControl ItemsSource="{Binding Owner.RunningAgents}" IsVisible="{Binding Owner.HasBackgroundAgents}">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<StackPanel
														Orientation="Horizontal"
														Spacing="7"
														Margin="2,4"
														IsVisible="{Binding IsBackground}">
														<Ellipse
															Width="5"
															Height="5"
															Fill="{DynamicResource AccentBrush}"
															VerticalAlignment="Center" />
														<PathIcon
															Data="{StaticResource IconPlay}"
															Width="{DynamicResource IconNano}"
															Height="{DynamicResource IconNano}"
															Foreground="{DynamicResource AccentBrush}"
															VerticalAlignment="Center"
															IsVisible="{Binding IsSubagent}"
															ToolTip.Tip="Subagent run — click to open the chat that spawned it" />
														<PathIcon
															Data="{StaticResource IconWarn}"
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Foreground="{DynamicResource WarnBrush}"
															VerticalAlignment="Center"
															IsVisible="{Binding NeedsAttention}"
															ToolTip.Tip="Waiting for a permission answer" />
														<StackPanel
															VerticalAlignment="Center"
															Background="Transparent"
															Cursor="Hand"
															Tapped="OnRunningClick"
															ToolTip.Tip="Open this chat">
															<TextBlock
																Text="{Binding Title}"
																TextTrimming="CharacterEllipsis"
																MaxWidth="220"
																FontSize="{DynamicResource FontBody}" />
															<TextBlock
																Text="{Binding Workspace}"
																FontSize="{DynamicResource FontMicro}"
																Opacity="0.5"
																IsVisible="{Binding $parent[ItemsControl].DataContext.Owner.MultipleWorkspaces}" />
														</StackPanel>
														<Button
															Classes="icon"
															Command="{Binding $parent[ItemsControl].DataContext.Owner.StopRunningCommand}"
															CommandParameter="{Binding SessionId}"
															VerticalAlignment="Center"
															ToolTip.Tip="Stop this agent">
															<PathIcon Data="{StaticResource IconStop}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
														</Button>
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</ScrollViewer>
							</Border>
						</Popup>
					</Panel>
		</StackPanel>
	</Grid>

	<!--  header/transcript divider  -->
	<Border Grid.Row="1" Height="1" Background="{DynamicResource TileHeaderSeparatorBrush}" Margin="10,6,10,0" />

	<!--  transcript  -->
	<Grid Grid.Row="2" Margin="4,2,4,4">
				<ScrollViewer x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="4">
						<ItemsControl ItemsSource="{Binding ChatItems}">
							<ItemsControl.DataTemplates>

								<DataTemplate DataType="{x:Type m:UserMessageItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Right"
										CornerRadius="12"
										Background="{DynamicResource BubbleUserBrush}"
										Padding="11,8"
										MaxWidth="560"
										Margin="40,4,0,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
												<MenuItem Header="Edit in input" Click="OnEditMessageClick" />
											</ContextMenu>
										</Border.ContextMenu>
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource FontBodyLarge}" LineHeight="19" />
											<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
												<Button
													Classes="msg-copy"
													Click="OnCopyMessage"
													ToolTip.Tip="Copy">
													<PathIcon Data="{StaticResource IconCopy}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
												</Button>
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" />
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:AssistantTextItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Left"
										CornerRadius="12"
										Background="{DynamicResource BubbleAssistantBrush}"
										BorderBrush="{DynamicResource HairlineBrush}"
										BorderThickness="1"
										Padding="11,8"
										MaxWidth="640"
										Margin="0,4,40,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
											<StackPanel Spacing="2">
												<mk:MarkdownViewer Markdown="{Binding Text, Mode=OneWay}" />
												<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
													<Button
														Classes="msg-copy"
														Click="OnCopyMessage"
														ToolTip.Tip="Copy">
														<PathIcon Data="{StaticResource IconCopy}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
													</Button>
													<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" Margin="6,0,0,0" />
												</StackPanel>
											</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ReasoningItem}">
									<Expander Classes="disclose chat-fold">
										<Expander.Header>
											<StackPanel Orientation="Horizontal" Spacing="6">
												<PathIcon
													Data="{StaticResource IconBulb}"
													Width="{DynamicResource IconSmall}"
													Height="{DynamicResource IconSmall}"
													Foreground="{DynamicResource TextMutedBrush}"
													VerticalAlignment="Center" />
												<TextBlock Text="thinking" FontStyle="Italic" Opacity="0.75" FontSize="{DynamicResource FontDetail}" />
											</StackPanel>
										</Expander.Header>
										<Border Classes="fold-body">
											<ScrollViewer Classes="fold-scroll">
												<TextBlock Classes="mono-detail" Text="{Binding Text}" />
											</ScrollViewer>
										</Border>
									</Expander>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ToolItem}">
									<StackPanel Margin="0,3" Spacing="3">
										<StackPanel.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</StackPanel.ContextMenu>
										<StackPanel Orientation="Horizontal" Spacing="7" Margin="4,0,44,0" Background="Transparent" VerticalAlignment="Center">
											<Ellipse
												Classes="tool-dot"
												Classes.running="{Binding IsRunning}"
												Classes.completed="{Binding IsCompleted}"
												Classes.error="{Binding IsError}" />
											<Border CornerRadius="6" Padding="6,2" Background="{DynamicResource ChipBrush}">
												<TextBlock Text="{Binding Tool}" FontSize="{DynamicResource FontXSmall}" FontFamily="{StaticResource CodeFont}" />
											</Border>
											<TextBlock
												Text="{Binding Title}"
												Opacity="0.8"
												TextTrimming="CharacterEllipsis"
												MaxWidth="440"
												FontSize="{DynamicResource FontBody}"
												VerticalAlignment="Center" />
											<TextBlock
												Text="{Binding Status}"
												Opacity="0.5"
												FontSize="{DynamicResource FontXSmall}"
												VerticalAlignment="Center" />
										</StackPanel>
										<TextBlock
											Classes="tool-error"
											Text="{Binding ErrorPreview}"
											IsVisible="{Binding IsError}"
											MaxWidth="520"
											HorizontalAlignment="Left"
											Margin="4,0,44,0"
											TextTrimming="CharacterEllipsis"
											ToolTip.Tip="{Binding ErrorPreview}" />
										<Expander Classes="disclose chat-fold" IsVisible="{Binding HasDiff}">
											<Expander.Header>
												<StackPanel Orientation="Horizontal" Spacing="8">
													<TextBlock Text="Changes" FontSize="{DynamicResource FontXSmall}" Opacity="0.75" />
													<StackPanel Orientation="Horizontal" Spacing="2" IsVisible="{Binding HasNumstat}">
														<TextBlock Text="{Binding Additions}" Foreground="{DynamicResource AddBrush}" FontSize="{DynamicResource FontXSmall}" />
														<TextBlock Text="{Binding Deletions}" Foreground="{DynamicResource DelBrush}" FontSize="{DynamicResource FontXSmall}" />
													</StackPanel>
												</StackPanel>
											</Expander.Header>
											<Border Classes="fold-body">
												<ScrollViewer Classes="fold-scroll">
													<c:DiffTextBlock Text="{Binding FileDiff}" />
												</ScrollViewer>
											</Border>
										</Expander>
										<Expander Classes="disclose chat-fold" IsVisible="{Binding HasDetails}">
											<Expander.Header>
												<TextBlock Text="details" FontSize="{DynamicResource FontXSmall}" Opacity="0.75" />
											</Expander.Header>
											<Border Classes="fold-body">
												<ScrollViewer Classes="fold-scroll">
													<TextBlock Classes="mono-detail" Text="{Binding Details}" />
												</ScrollViewer>
											</Border>
										</Expander>
									</StackPanel>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:ImageItem}">
									<Border
										Classes="msg-surface"
										HorizontalAlignment="Right"
										CornerRadius="12"
										Background="{DynamicResource BubbleUserBrush}"
										Padding="8"
										MaxWidth="380"
										Margin="40,4,0,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy image" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<StackPanel Spacing="3">
											<Image
												Source="{Binding Preview}"
												MaxWidth="360"
												MaxHeight="240"
												Stretch="Uniform"
												HorizontalAlignment="Left" />
											<StackPanel Orientation="Horizontal" Spacing="6">
												<TextBlock Text="{Binding FileName}" FontSize="{DynamicResource FontXSmall}" Opacity="0.7" VerticalAlignment="Center" />
												<TextBlock Classes="msg-time" Text="{Binding TimeLabel}" VerticalAlignment="Center" />
											</StackPanel>
										</StackPanel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:PermissionItem}">
									<Border
										HorizontalAlignment="Left"
										CornerRadius="10"
										Background="{DynamicResource WarnBgBrush}"
										MaxWidth="640"
										Margin="0,4,40,4">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<Grid ColumnDefinitions="Auto,*">
											<Border
												Width="3"
												Margin="6,8"
												CornerRadius="2"
												Background="{DynamicResource WarnBrush}" />
											<StackPanel Grid.Column="1" Spacing="4" Margin="0,7,10,7">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<PathIcon
														Data="{StaticResource IconShield}"
														Width="{DynamicResource IconMedium}"
														Height="{DynamicResource IconMedium}"
														Foreground="{DynamicResource WarnBrush}"
														VerticalAlignment="Center" />
													<TextBlock
														Text="{Binding Kind}"
														FontWeight="SemiBold"
														Foreground="{DynamicResource WarnBrush}"
														VerticalAlignment="Center" />
													<TextBlock
														Text="{Binding DetailPreview}"
														FontFamily="{StaticResource CodeFont}"
														FontSize="{DynamicResource FontDetail}"
														MaxWidth="330"
														TextTrimming="CharacterEllipsis"
														VerticalAlignment="Center"
														Opacity="0.9"
														ToolTip.Tip="{Binding Detail}" />
													<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPending}">
														<Button Classes="btn-allow" Content="Allow" Command="{Binding AllowCommand}" />
														<Button
															Classes="btn-soft-accent"
															Content="Always"
															Command="{Binding AllowAlwaysCommand}"
															ToolTip.Tip="Always allow this permission" />
														<Button Classes="btn-deny" Content="Deny" Command="{Binding DenyCommand}" />
														<TextBlock
															Text="{Binding AutoCountdownText}"
															IsVisible="{Binding HasAutoCountdown}"
															FontStyle="Italic"
															FontSize="{DynamicResource FontXSmall}"
															Opacity="0.7"
															VerticalAlignment="Center" />
													</StackPanel>
													<TextBlock
														Text="{Binding Answer}"
														IsVisible="{Binding !IsPending}"
														Opacity="0.85"
														FontStyle="Italic"
														VerticalAlignment="Center" />
												</StackPanel>
												<Expander Classes="disclose chat-fold" IsVisible="{Binding HasDiff}">
													<Expander.Header>
														<TextBlock Text="View diff" FontSize="{DynamicResource FontXSmall}" Opacity="0.7" />
													</Expander.Header>
													<Border Classes="fold-body">
														<ScrollViewer Classes="fold-scroll">
															<c:DiffTextBlock Text="{Binding Diff}" />
														</ScrollViewer>
													</Border>
												</Expander>
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:QuestionItem}">
									<Border Classes="q-card">
										<Border.ContextMenu>
											<ContextMenu>
												<MenuItem Header="Copy" Click="OnCopyMessage" />
											</ContextMenu>
										</Border.ContextMenu>
										<Grid>
											<StackPanel Spacing="4" Margin="10,7,10,7">
												<StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding IsPending}">
													<Ellipse Classes="tool-dot running" VerticalAlignment="Center" />
													<TextBlock Text="question" FontWeight="SemiBold" FontSize="{DynamicResource FontBody}" VerticalAlignment="Center" />
													<TextBlock Text="pick an answer for each question" FontSize="{DynamicResource FontXSmall}" Opacity="0.5" VerticalAlignment="Center" />
												</StackPanel>
												<ItemsControl ItemsSource="{Binding Questions}" Margin="0,2,0,0">
													<ItemsControl.ItemTemplate>
														<DataTemplate DataType="{x:Type m:QuestionEntry}">
															<StackPanel Spacing="5" Margin="0,0,0,4" IsEnabled="{Binding !Locked}">
																<TextBlock
																	Text="{Binding Header}"
																	FontSize="{DynamicResource FontXSmall}"
																	FontWeight="SemiBold"
																	Opacity="0.55" />
																<TextBlock Text="{Binding Question}" FontSize="{DynamicResource FontBody}" TextWrapping="Wrap" />
																<ItemsControl ItemsSource="{Binding Options}">
																	<ItemsControl.ItemTemplate>
																		<DataTemplate DataType="{x:Type m:QuestionOptionItem}">
																			<Button
																				Classes="q-opt"
																				Classes.selected="{Binding IsSelected}"
																				Margin="0,0,0,3"
																				Command="{Binding $parent[ItemsControl].DataContext.ToggleOptionCommand}"
																				CommandParameter="{Binding}">
																				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
																					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
																						<!--  multi-select asks get a checkbox marker; single keeps circle + tick  -->
																						<Panel IsVisible="{Binding $parent[ItemsControl].DataContext.Multiple}">
																							<Border
																								Width="13"
																								Height="13"
																								CornerRadius="3"
																								BorderThickness="1"
																								BorderBrush="{DynamicResource TextMutedBrush}"
																								VerticalAlignment="Center"
																								IsVisible="{Binding !IsSelected}" />
																							<Border
																								Width="13"
																								Height="13"
																								CornerRadius="3"
																								Background="{DynamicResource AccentBrush}"
																								VerticalAlignment="Center"
																								IsVisible="{Binding IsSelected}">
																								<PathIcon
																									Data="{StaticResource IconCheck}"
																									Width="{DynamicResource IconNano}"
																									Height="{DynamicResource IconNano}"
																									Foreground="{DynamicResource SurfaceBrush}"
																									HorizontalAlignment="Center"
																									VerticalAlignment="Center" />
																							</Border>
																						</Panel>
																						<Panel IsVisible="{Binding !$parent[ItemsControl].DataContext.Multiple}">
																							<PathIcon
																								Data="{StaticResource IconCheck}"
																								Width="{DynamicResource IconSmall}"
																								Height="{DynamicResource IconSmall}"
																								VerticalAlignment="Center"
																								Foreground="{DynamicResource AccentBrush}"
																								IsVisible="{Binding IsSelected}" />
																							<Ellipse
																								Width="12"
																								Height="12"
																								StrokeThickness="1"
																								Stroke="{DynamicResource TextMutedBrush}"
																								VerticalAlignment="Center"
																								IsVisible="{Binding !IsSelected}" />
																						</Panel>
																					</StackPanel>
																					<StackPanel Grid.Column="1" Spacing="1">
																						<TextBlock Text="{Binding Label}" FontSize="{DynamicResource FontBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
																						<TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontDetail}" Opacity="0.6" TextWrapping="Wrap" />
																					</StackPanel>
																				</Grid>
																			</Button>
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>
																<TextBox
																	Classes="q-custom"
																	Text="{Binding CustomText}"
																	PlaceholderText="custom answer…"
																	IsVisible="{Binding !Locked}"
																	IsEnabled="{Binding !Locked}"
																	ToolTip.Tip="Type your own answer — it wins over picked options" />
															</StackPanel>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
												<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding IsPending}">
													<Button
														Classes="btn-soft-accent"
														Content="Answer"
														Command="{Binding SubmitCommand}"
														IsEnabled="{Binding CanSubmit}"
														ToolTip.Tip="Send the answers — the turn continues" />
													<Button Classes="icon" Command="{Binding DismissCommand}" ToolTip.Tip="Dismiss — the agent sees the ask was rejected">
														<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
													</Button>
												</StackPanel>
												<TextBlock
													Text="{Binding Resolution}"
													IsVisible="{Binding !IsPending}"
													FontStyle="Italic"
													FontSize="{DynamicResource FontSmall}"
													Opacity="0.75"
													Margin="0,3,0,0"
													TextWrapping="Wrap" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="{x:Type m:SystemNoteItem}">
									<Panel>
										<!--  errors: red section card, same family as the permission card  -->
										<Border Classes="error-card" IsVisible="{Binding IsError}">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</Border.ContextMenu>
											<Grid ColumnDefinitions="Auto,*">
												<Border
													Width="3"
													Margin="6,8"
													CornerRadius="2"
													Background="{DynamicResource DangerBrush}" />
												<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" Margin="0,7,10,7" VerticalAlignment="Center">
													<Ellipse Classes="tool-dot error" VerticalAlignment="Center" />
													<TextBlock
														Text="{Binding Text}"
														Foreground="{DynamicResource DangerBrush}"
														FontSize="{DynamicResource FontSmall}"
														TextWrapping="Wrap"
														VerticalAlignment="Center" />
												</StackPanel>
											</Grid>
										</Border>
										<!--  plain informational notes stay as centered muted lines  -->
										<TextBlock
											Classes="note"
											IsVisible="{Binding !IsError}"
											Text="{Binding Text}">
											<TextBlock.ContextMenu>
												<ContextMenu>
													<MenuItem Header="Copy" Click="OnCopyMessage" />
												</ContextMenu>
											</TextBlock.ContextMenu>
										</TextBlock>
									</Panel>
								</DataTemplate>

								</ItemsControl.DataTemplates>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>

				<Button
					x:Name="JumpLatest"
					Classes="jump-btn"
					IsVisible="False"
					HorizontalAlignment="Right"
					VerticalAlignment="Bottom"
					Margin="0,0,8,8"
					Click="OnJumpLatestClicked"
					ToolTip.Tip="Jump to the latest message">
					<PathIcon Data="{StaticResource IconArrowDown}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
				</Button>
			</Grid>

			<!--  queued prompts pinned right above the composer: a fixed strip, not
			      items interleaved in the transcript; capped so a long queue
			      squeezes the transcript only up to a point  -->
			<ScrollViewer Grid.Row="3" MaxHeight="150" Margin="4,0,4,2" IsVisible="{Binding HasQueueRows}">
				<ItemsControl ItemsSource="{Binding QueueRows}">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<!--  Warp-style queue row: full width, steer / edit / remove on the right  -->
							<Border
								HorizontalAlignment="Stretch"
								CornerRadius="10"
								Background="{DynamicResource BubbleQueuedBrush}"
								BorderBrush="{DynamicResource QueuedBorderBrush}"
								BorderThickness="1"
								Padding="10,7"
								Margin="0,3"
								ToolTip.Tip="Queued — sent when the current turn finishes">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
									<StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="{DynamicResource FontBodyLarge}" />
										<TextBlock
											Text="{Binding ImageCount, StringFormat='{}{0} attachment(s)'}"
											FontSize="{DynamicResource FontXSmall}"
											Opacity="0.6"
											IsVisible="{Binding HasImages}" />
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
										<Button Classes="queue-steer" Command="{Binding SteerSelfCommand}" ToolTip.Tip="Send next — interrupt the running turn">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<PathIcon Data="{StaticResource IconArrowUp}" Width="{DynamicResource IconTiny}" Height="{DynamicResource IconTiny}" />
												<TextBlock Text="Steer" FontSize="{DynamicResource FontXSmall}" />
											</StackPanel>
										</Button>
										<Button Classes="icon" Command="{Binding EditSelfCommand}" ToolTip.Tip="Edit — pull back into the composer">
											<PathIcon Data="{StaticResource IconEdit}" Width="{DynamicResource IconSmall}" Height="{DynamicResource IconSmall}" />
										</Button>
										<Button Classes="icon" Command="{Binding RemoveSelfCommand}" ToolTip.Tip="Remove from queue">
											<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>

			<!--  Composer  -->
			<Border
				Grid.Row="4"
				Classes="input-card"
				Tapped="OnComposerTapped"
				CornerRadius="14"
				Background="{DynamicResource InputBrush}"
				BorderThickness="1"
				Padding="6"
				Margin="4,0,4,4"
				DragDrop.DragOver="OnFileDragOver"
				DragDrop.Drop="OnFileDrop">
					<StackPanel Spacing="6">
						<ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Horizontal" Spacing="6" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border CornerRadius="8" Background="{DynamicResource ChipBrush}" Padding="4">
										<StackPanel>
											<Image
												Source="{Binding Preview}"
												Width="56"
												Height="56"
												Stretch="Uniform"
												IsVisible="{Binding IsImage}" />
											<PathIcon
												Data="{StaticResource IconDoc}"
												Width="56"
												Height="56"
												Foreground="{DynamicResource TextMutedBrush}"
												IsVisible="{Binding !IsImage}" />
											<Button
												Classes="icon"
												HorizontalAlignment="Center"
												Command="{Binding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
												CommandParameter="{Binding}"
												ToolTip.Tip="Remove attachment">
												<PathIcon Data="{StaticResource IconClose}" Width="{DynamicResource IconXSmall}" Height="{DynamicResource IconXSmall}" />
											</Button>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBox
						x:Name="InputBox"
						Text="{Binding Input}"
						PlaceholderText="Ask opencode…"
						AcceptsReturn="True"
						VerticalContentAlignment="Top"
						MinHeight="52"
						Background="Transparent"
						BorderThickness="0"
						Padding="4,6,4,0"
						IsEnabled="{Binding IsConnected}"
						ToolTip.Tip="Enter to send · Shift+Enter for a new line" />
						<!--  left: attach + auto-allow; right: pills; send hugs the far right  -->
						<Grid ColumnDefinitions="*,Auto,Auto">
							<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
								<Button
									Classes="icon attach-btn"
									Click="OnAttachClick"
									ToolTip.Tip="Attach files">
									<PathIcon Data="{StaticResource IconPlus}" Width="{DynamicResource IconMedium}" Height="{DynamicResource IconMedium}" />
								</Button>
								<ToggleButton
									Classes="icon allow-toggle"
									Classes.on="{Binding Owner.AutoAllow}"
									IsChecked="{Binding Owner.AutoAllow}"
									ToolTip.Tip="Auto-allow">
									<Panel>
										<PathIcon Data="{StaticResource IconShieldFilled}" Width="{DynamicResource IconMedium}" Height="{DynamicResource IconMedium}" IsVisible="{Binding Owner.AutoAllow}" />
										<PathIcon Data="{StaticResource IconShield}" Width="{DynamicResource IconMedium}" Height="{DynamicResource IconMedium}" IsVisible="{Binding !Owner.AutoAllow}" />
									</Panel>
								</ToggleButton>
							</StackPanel>
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
								<Button Classes="composer-pill" Click="OnAgentPillClick" IsVisible="{Binding Owner.HasAgents}" ToolTip.Tip="Agent for the next message">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<TextBlock Text="{Binding SelectedAgent}" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" />
										<PathIcon Data="{StaticResource IconChevronDown}" Width="{DynamicResource IconTiny}" Height="{DynamicResource IconTiny}" Opacity="0.6" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button Classes="composer-pill" Click="OnModelPillClick" ToolTip.Tip="Model for the next message">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<TextBlock Text="{Binding SelectedModelShort}" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" />
										<PathIcon Data="{StaticResource IconChevronDown}" Width="{DynamicResource IconTiny}" Height="{DynamicResource IconTiny}" Opacity="0.6" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<Button
									Classes="composer-pill"
									Click="OnVariantPillClick"
									IsEnabled="{Binding HasVariants}"
									ToolTip.Tip="Model variant (e.g. reasoning effort)">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<PathIcon Data="{StaticResource IconGauge}" Width="{DynamicResource IconBody}" Height="{DynamicResource IconBody}" Opacity="0.8" VerticalAlignment="Center" />
										<TextBlock Text="{Binding SelectedVariant}" FontSize="{DynamicResource FontSmall}" VerticalAlignment="Center" />
										<PathIcon Data="{StaticResource IconChevronDown}" Width="{DynamicResource IconTiny}" Height="{DynamicResource IconTiny}" Opacity="0.6" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
							</StackPanel>
							<Button
								Grid.Column="2"
								x:Name="SendButton"
								Classes="btn-send"
								VerticalAlignment="Center"
								Command="{Binding SendCommand}"
								IsVisible="{Binding !IsBusy}"
								IsEnabled="{Binding IsConnected}">
								<PathIcon Data="{StaticResource IconArrowUp}" Width="{DynamicResource IconXL}" Height="{DynamicResource IconXL}" />
							</Button>
							<Button
								Grid.Column="2"
								Classes="btn-stop"
								VerticalAlignment="Center"
								Command="{Binding AbortCommand}"
								IsVisible="{Binding IsBusy}"
								IsEnabled="{Binding IsConnected}">
								<PathIcon Data="{StaticResource IconStop}" Width="{DynamicResource IconMedium}" Height="{DynamicResource IconMedium}" />
							</Button>
						</Grid>
				</StackPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>
