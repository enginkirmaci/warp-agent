	</Application.Resources>
	<Application.Styles>
		<suki:SukiTheme ThemeColor="Blue" />

		<!--  anchor tooltips to the control, not the pointer: default Pointer placement drops the
		      balloon onto these 30px icon buttons and the popup window swallows the click  -->
		<Style Selector="ToolTip">
			<Setter Property="ToolTip.Placement" Value="Top" />
			<Setter Property="ToolTip.VerticalOffset" Value="-2" />
		</Style>

		<!--  every icon button renders as a square with a centered glyph  -->
		<Style Selector="Button.icon">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="ToggleButton.icon">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<!--  the one working indicator: a single dot next to a chat tile's title (fixed WorkingBrush green, not accent)  -->
		<Style Selector="Ellipse.pulse">
			<Setter Property="Width" Value="5" />
			<Setter Property="Height" Value="5" />
			<Setter Property="Fill" Value="{DynamicResource WorkingBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Style.Animations>
				<Animation Duration="0:0:2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
					<KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
					<KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!--  sidebar progress spinner: 8-spoke burst breathing while a chat's turn runs
		      (RenderTransform rotation has no animator registered in this Avalonia build); fixed green  -->
		<Style Selector="PathIcon.spin">
			<Setter Property="Foreground" Value="{DynamicResource WorkingBrush}" />
			<Style.Animations>
				<Animation Duration="0:0:1.2" IterationCount="Infinite">
					<KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
					<KeyFrame Cue="50%"><Setter Property="Opacity" Value="1" /></KeyFrame>
					<KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!--  chat disclosure — flat expander for thinking rows, tool details and diffs; full row is the click target.
		      Expanded state gains a rounded hairline card frame (Border.fold-root.expanded) around header + body  -->
		<Style Selector="Expander.disclose">
			<Setter Property="Template">
				<ControlTemplate TargetType="Expander">
					<Border
						Name="FoldRoot"
						Classes="fold-root"
						Classes.expanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
						Background="Transparent"
						BorderBrush="Transparent"
						BorderThickness="1"
						CornerRadius="9">
						<StackPanel>
							<ToggleButton
								Focusable="False"
								Background="Transparent"
								Padding="0"
								HorizontalAlignment="Stretch"
								IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
								Tag="{TemplateBinding Header}">
								<ToggleButton.Template>
									<ControlTemplate TargetType="ToggleButton">
										<Border
											Background="{TemplateBinding Background}"
											Padding="9,5"
											CornerRadius="8">
											<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
												<ContentPresenter Content="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" />
												<PathIcon
													Grid.Column="1"
													Data="{StaticResource IconChevronRight}"
													Width="11"
													Height="11"
													Opacity="0.55"
													VerticalAlignment="Center"
													IsVisible="{Binding !IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
												<PathIcon
													Grid.Column="1"
													Data="{StaticResource IconChevronDown}"
													Width="11"
													Height="11"
													Opacity="0.55"
													VerticalAlignment="Center"
													IsVisible="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
											</Grid>
										</Border>
									</ControlTemplate>
								</ToggleButton.Template>
							</ToggleButton>
							<ContentPresenter
								Margin="0,3,0,0"
								IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}" />
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<!--  toggle states must be pinned with /template/ selectors: styles don't cross template
		      boundaries, so a plain `Expander.disclose ToggleButton:pointerover` never matches and
			      SukiUI's accent-filled toggle state styles leak through (silver header bar)  -->
		<Style Selector="Expander.disclose /template/ ToggleButton">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="Expander.disclose /template/ ToggleButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Expander.disclose /template/ ToggleButton:pressed">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Expander.disclose /template/ ToggleButton:checked">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Expander.disclose /template/ ToggleButton:checked:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Expander.disclose /template/ ToggleButton:checked:pressed">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<Style Selector="Border.fold-root">
			<Setter Property="BorderBrush" Value="Transparent" />
		</Style>
		<Style Selector="Border.fold-root.expanded">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="Padding" Value="6,2,6,6" />
		</Style>

		<!--  uniform frame for every collapsible block inside a chat tile:
		      same alignment, margins and 260px scroll cap;
		      only header icons/labels and content colors may differ  -->
		<Style Selector="Expander.chat-fold">
			<Setter Property="IsExpanded" Value="False" />
			<!--  stretches to the full tile width; headers stay left-aligned (no MaxWidth on the
			      expander itself — Stretch+MaxWidth centers in Avalonia)  -->
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Margin" Value="0,2" />
		</Style>
		<Style Selector="Border.fold-body">
			<Setter Property="Background" Value="{DynamicResource DiffBgBrush}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="9,7" />
		</Style>
		<Style Selector="ScrollViewer.fold-scroll">
			<Setter Property="MaxHeight" Value="260" />
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
		</Style>
	</Application.Styles>
</Application>
