<?xml version="1.0" encoding="utf-8" ?>
<Application
	x:Class="WarpAgent.App"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:sys="using:System"
	RequestedThemeVariant="Dark">
	<Application.Resources>
		<ResourceDictionary>
			<FontFamily x:Key="CodeFont">DejaVu Sans Mono, Consolas, monospace</FontFamily>

			<!--  typography tokens — every FontSize binds these via DynamicResource so the
			      settings-page text-size variant can swap the values at runtime  -->
			<sys:Double x:Key="FontMicro">10.5</sys:Double>
			<sys:Double x:Key="FontXSmall">11</sys:Double>
			<sys:Double x:Key="FontDetail">11.5</sys:Double>
			<sys:Double x:Key="FontSmall">12</sys:Double>
			<sys:Double x:Key="FontBody">12.5</sys:Double>
			<sys:Double x:Key="FontBodyLarge">13</sys:Double>
			<sys:Double x:Key="FontH1">18</sys:Double>
			<sys:Double x:Key="FontH2">16</sys:Double>
			<sys:Double x:Key="FontH3">14.5</sys:Double>
			<sys:Double x:Key="FontTitle">19</sys:Double>
			<!--  icon sizes scale in lockstep with the font tokens (see FontScale)  -->
			<sys:Double x:Key="IconNano">9</sys:Double>
			<sys:Double x:Key="IconTiny">10</sys:Double>
			<sys:Double x:Key="IconXSmall">11</sys:Double>
			<sys:Double x:Key="IconSmall">12</sys:Double>
			<sys:Double x:Key="IconBody">13</sys:Double>
			<sys:Double x:Key="IconMedium">14</sys:Double>
			<sys:Double x:Key="IconLarge">15</sys:Double>
			<sys:Double x:Key="IconXL">17</sys:Double>

			<!--  surfaces — neutral grays (R=G=B) with a wide luminance ladder:
      dark canvas, elevated cards, inset code/diff, visible hairlines  -->
			<SolidColorBrush x:Key="SurfaceBrush" Color="#FF121212" />
			<!--  settings page sheet: visibly lighter than both the surface and the chrome so the
			      page reads as its own layer  -->
			<SolidColorBrush x:Key="SettingsBgBrush" Color="#FF202020" />
			<!--  settings cards: one gray step down from the sheet, hairline border does the separation  -->
			<SolidColorBrush x:Key="SettingsCardBrush" Color="#FF1A1A1A" />
			<!--  flyout card: same tone as SurfaceBrush, 0.7 opacity so the chat shows through  -->
			<SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="#B3121212" />
			<!--  primary text: PopupRoot misses the themed TextBlock default, so raw Popup
			      content (tasks flyout) needs this set explicitly or it renders invisible  -->
			<SolidColorBrush x:Key="TextBrush" Color="#FFE4E4E4" />
			<!--  tile surface (also restore bar, error dialog, expanded folds): same tone as the
			      main-area card since 2026-09-20 — the hairline border does the separation  -->
			<SolidColorBrush x:Key="CardBrush" Color="#FF121212" />
			<SolidColorBrush x:Key="InputBrush" Color="#FF2A2A2A" />
			<SolidColorBrush x:Key="HairlineBrush" Color="#FF3E3E3E" />
			<!--  tile header divider: one step darker than HairlineBrush so it sits quieter on the #121212 tile  -->
			<SolidColorBrush x:Key="TileHeaderSeparatorBrush" Color="#FF333333" />
			<SolidColorBrush x:Key="ChipBrush" Color="#FF343434" />
			<SolidColorBrush x:Key="DiffBgBrush" Color="#FF171717" />
			<SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />

			<!--  chat surfaces  -->
			<SolidColorBrush x:Key="BubbleUserBrush" Color="#FF343434" />
			<SolidColorBrush x:Key="BubbleAssistantBrush" Color="#FF282828" />
			<!--  picked question-option row: neutral gray lift, not accent  -->
			<SolidColorBrush x:Key="QOptSelectedBrush" Color="#FF333333" />
			<SolidColorBrush x:Key="BubbleQueuedBrush" Color="#FF272727" />
			<SolidColorBrush x:Key="QueuedBorderBrush" Color="#FF4E4E4E" />

			<!--  accents — green primary, salmon red, amber; deliberately no blue  -->
			<SolidColorBrush x:Key="AccentBrush" Color="#FF4AC265" />
			<SolidColorBrush x:Key="AccentDimBrush" Color="#FF223322" />
			<SolidColorBrush x:Key="OnAccentBrush" Color="#FF0C140C" />
			<SolidColorBrush x:Key="SuccessBrush" Color="#FF4AC265" />
			<SolidColorBrush x:Key="SuccessDimBrush" Color="#FF1D3122" />
			<SolidColorBrush x:Key="DangerBrush" Color="#FFF47067" />
			<SolidColorBrush x:Key="DangerDimBrush" Color="#FF3B2523" />
			<SolidColorBrush x:Key="WarnBrush" Color="#FFE8A348" />
			<SolidColorBrush x:Key="WarnBgBrush" Color="#FF3A2D1A" />
			<SolidColorBrush x:Key="AddBrush" Color="#FF56C272" />
			<SolidColorBrush x:Key="DelBrush" Color="#FFF47067" />
			<SolidColorBrush x:Key="TextMutedBrush" Color="#FF9A9A9A" />
			<!--  working indicators (tile pulse dot, sidebar spinner): fixed green whatever the
			      accent preset — AccentTheme deliberately leaves this key alone, so a
			      silver/charcoal accent cannot gray the loading animations out  -->
			<SolidColorBrush x:Key="WorkingBrush" Color="#FF4AC265" />

			<!--  code  -->
			<SolidColorBrush x:Key="CodeBlockBrush" Color="#FF171717" />
			<SolidColorBrush x:Key="CodeFgBrush" Color="#FFE4E4E4" />
			<SolidColorBrush x:Key="SynKeywordBrush" Color="#FFA9A9A9" />
			<SolidColorBrush x:Key="SynStringBrush" Color="#FF93B585" />
			<SolidColorBrush x:Key="SynCommentBrush" Color="#FF6F6F6F" />
			<SolidColorBrush x:Key="SynNumberBrush" Color="#FFC9986E" />

			<!--  SukiUI surface overrides — its dark theme stays blue-cast otherwise
			      (window shader excluded: MainWindow's root paints over it)  -->
			<!--  chrome (titlebar, sidebar, ring): one step lighter than the #121212 canvas so the
			      rounded main card reads; unified-black experiment lasted a few hours (2026-09-20)  -->
			<SolidColorBrush x:Key="WindowChromeBrush" Color="#FF1E1E1E" />
			<SolidColorBrush x:Key="SukiStrongBackground" Color="#FF121212" />
			<SolidColorBrush x:Key="SukiCardBackground" Color="#FF1E1E1E" />
			<!--  opaque on purpose: the translucent default lets the background
			      shader bleed through the window titlebar glass  -->
			<SolidColorBrush x:Key="SukiGlassCardBackground" Color="#FF121212" />
			<SolidColorBrush x:Key="SukiPopupBackground" Color="#FF2A2A2A" />
			<SolidColorBrush x:Key="SukiGlassCardOpaqueBackground" Color="#FF343434" />
			<SolidColorBrush x:Key="SukiDialogBackground" Color="#FF121212" />
			<SolidColorBrush x:Key="SukiControlTouchBackground" Color="#FF3A3A3A" />
			<SolidColorBrush x:Key="SukiBorderBrush" Color="#FF3E3E3E" />
			<SolidColorBrush x:Key="SukiControlBorderBrush" Color="#FF4E4E4E" />
			<SolidColorBrush x:Key="SukiMediumBorderBrush" Color="#FF484848" />
			<SolidColorBrush x:Key="SukiLightBorderBrush" Color="#FF3E3E3E" />
			<SolidColorBrush x:Key="SukiMenuBorderBrush" Color="#FF3E3E3E" />
			<SolidColorBrush x:Key="SukiMuteText" Color="#FF9A9A9A" />

			<!--  SukiUI's fixed blue sources that don't derive from the theme color
			      (info sematics, legacy accent family, picker flyouts, glass border).
			      Defined as Color to match the originals so both Color and IBrush
