<?xml version="1.0" encoding="utf-8" ?>
<suki:SukiWindow
	x:Class="WarpAgent.Views.MainWindow"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:c="using:WarpAgent.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:suki="https://github.com/kikipoulet/SukiUI"
	xmlns:v="using:WarpAgent.Views"
	xmlns:vm="using:WarpAgent.ViewModels"
	Title="Warp Agent"
	Width="1180"
	Height="800"
	MinWidth="860"
	MinHeight="580"
	x:DataType="vm:MainViewModel"
	BackgroundAnimationEnabled="False"
	BackgroundStyle="Flat"
	Icon="avares://WarpAgent/Assets/spark.png"
	WindowStartupLocation="CenterScreen"
	mc:Ignorable="d">

	<suki:SukiWindow.LogoContent>
		<!--
			logo and the sidebar toggle share one slot: at rest only the spark shows,
			hovering the slot swaps it for the toggle. PART_Logo is ElementRole=User,
			so the button stays clickable and the titlebar drag never swallows its
			presses; Background=Transparent keeps :pointerover alive across the
			whole slot, not just the glyphs
		-->
		<Panel
			Classes="logo-swap"
			Background="Transparent"
			VerticalAlignment="Center">
			<PathIcon
					Classes="logo-glyph"
					Width="{DynamicResource IconLarge}"
					Height="{DynamicResource IconLarge}"
					Data="{StaticResource IconSpark}"
					Foreground="{DynamicResource SparkFillBrush}" />
			<Button
				Classes="icon titlebar-btn"
				Click="OnToggleSidebarClick"
				ToolTip.Tip="{Binding SidebarToggleTip}">
				<Panel>
					<PathIcon
						Width="{DynamicResource IconMedium}"
						Height="{DynamicResource IconMedium}"
						Data="{StaticResource IconPanelLeft}"
						IsVisible="{Binding SidebarVisible}" />
					<PathIcon
						Width="{DynamicResource IconMedium}"
						Height="{DynamicResource IconMedium}"
						Data="{StaticResource IconPanelLeftOpen}"
						IsVisible="{Binding !SidebarVisible}" />
				</Panel>
			</Button>
		</Panel>
	</suki:SukiWindow.LogoContent>

	<suki:SukiWindow.Styles>
		<!--
			flatten the titlebar too: the SukiUI shader (waves/gradient) must never show.
			PART_TitleBarBackground is a GlassCard, not a Border — its card layer paints
			the background at GlassOpacity (0.18) so the shader bleeds through, and
			PART_ClipBorder stacks another tint on top; pin both to the flat chrome
		-->
		<Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground /template/ Border.GlassCardBorderPartCard">
			<Setter Property="Background" Value="{DynamicResource WindowChromeBrush}" />
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="suki|SukiWindow /template/ suki|GlassCard#PART_TitleBarBackground /template/ Border#PART_ClipBorder">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<!--  SukiUI's hairline under the titlebar  -->
		<Style Selector="suki|SukiWindow /template/ Border#PART_BottomBorder">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="Border.pill">
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="11,4" />
			<Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
		</Style>
		<Style Selector="Border.pill.on">
			<Setter Property="Background" Value="{DynamicResource SuccessDimBrush}" />
		</Style>
		<Style Selector="TextBlock.sidebar-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="Margin" Value="4,8" />
		</Style>

		<!--
			sidebar rows draw their own hover + selection; SukiUI's check badge and
			selected tint are suppressed — selection is the accent border only
		-->
		<Style Selector="Border.row-card">
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<!--  the focused chat's row keeps a soft accent tint; hover still wins while pointing  -->
		<Style Selector="Border.row-card.selected">
			<Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
		</Style>
		<Style Selector="Border.row-card:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  sidebar actions (workspace rows and the Workspaces header +) appear on hover only  -->
		<Style Selector="Button.ws-action">
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Border.row-card:pointerover Button.ws-action, Grid.projects-header:pointerover Button.ws-action">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>

		<!--
			the chat row's updated-at time is the inverse: visible at rest, gone on hover
			(its place is taken by the delete ws-action button; opacity must live in a
			style because a local value would beat the hover setter)
		-->
		<Style Selector="TextBlock.row-time">
			<Setter Property="Opacity" Value="0.45" />
		</Style>
		<Style Selector="Border.row-card:pointerover TextBlock.row-time">
			<Setter Property="Opacity" Value="0" />
		</Style>

		<Style Selector="ListBoxItem /template/ PathIcon#CheckSelected">
			<Setter Property="IsVisible" Value="False" />
		</Style>
		<Style Selector="ListBoxItem:selected /template/ suki|GlassCard#BorderBasicStyle">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>

		<Style Selector="TextBlock.task-done">
			<Setter Property="TextDecorations" Value="Strikethrough" />
			<Setter Property="Opacity" Value="0.45" />
		</Style>

		<!--  buttons  -->
		<!--  outlined buttons: no fill, hairline border; hover lifts bg and border a step  -->
		<Style Selector="Button.btn-soft">
			<Setter Property="Padding" Value="10,5" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Button.btn-soft:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SukiControlBorderBrush}" />
		</Style>

		<!--  relaunch banner: flat hairline chip floating at the top of the tile grid  -->
		<Style Selector="Border.restore-bar">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="9" />
			<Setter Property="Padding" Value="14,7" />
		</Style>
		<Style Selector="Border.restore-bar Button.btn-soft">
			<Setter Property="MinHeight" Value="26" />
			<Setter Property="Padding" Value="12,3" />
		</Style>

		<!--  sidebar footer settings button: bare icon+label, tint on hover only  -->
		<Style Selector="Button.settings-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,5" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>
		<Style Selector="Button.settings-btn:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--
			titlebar sidebar toggle: chrome-less, sized to the 32px titlebar and living
			in the logo's slot — hover swaps the spark for the toggle, never both at
			once; opacity (not visibility) keeps the slot size stable so the window
			title never jumps
		-->
		<Style Selector="Panel.logo-swap:pointerover PathIcon.logo-glyph">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="Button.titlebar-btn">
			<Setter Property="Width" Value="26" />
			<Setter Property="Height" Value="26" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="7" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Opacity" Value="0" />
			<Setter Property="IsHitTestVisible" Value="False" />
		</Style>
		<Style Selector="Panel.logo-swap:pointerover Button.titlebar-btn">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="IsHitTestVisible" Value="True" />
		</Style>
		<Style Selector="Button.titlebar-btn:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>

		<!--  accent swatches: chrome-less color dot, muted ring when its preset is picked  -->
		<Style Selector="RadioButton.accent-swatch">
			<Setter Property="Template">
				<ControlTemplate>
					<Border
						x:Name="SwatchDot"
						Width="24"
						Height="24"
						Background="{Binding SwatchBrush}"
						BorderBrush="Transparent"
						BorderThickness="2"
						CornerRadius="12" />
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="RadioButton.accent-swatch:checked /template/ Border#SwatchDot">
			<Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="RadioButton.accent-swatch:pointerover /template/ Border#SwatchDot">
			<Setter Property="Opacity" Value="0.8" />
		</Style>

		<!--  settings page: muted section label above a hairline card; rows are label + control  -->
		<Style Selector="TextBlock.settings-section">
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="Margin" Value="2,0,0,0" />
		</Style>
		<Style Selector="Border.settings-card">
			<Setter Property="Background" Value="{DynamicResource SettingsCardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="16,12" />
		</Style>
		<Style Selector="TextBlock.settings-hint">
			<Setter Property="Opacity" Value="0.5" />
			<Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
			<Setter Property="FontStyle" Value="Italic" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="TextAlignment" Value="Left" />
			<Setter Property="Margin" Value="0,2,0,0" />
		</Style>
		<Style Selector="TextBlock.settings-label">
			<Setter Property="FontSize" Value="{DynamicResource FontBody}" />
			<Setter Property="Opacity" Value="0.9" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!--  sidebar resize handle: invisible until hovered  -->
		<Style Selector="GridSplitter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="GridSplitter:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBrush}" />
		</Style>
		<!--  error overlay: the crash-guard dialog shown over everything  -->
		<Style Selector="Border.error-dialog">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="18" />
		</Style>
		<Style Selector="Border.error-detail">
			<Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="10" />
		</Style>
		<Style Selector="TextBlock.error-sub">
			<Setter Property="FontSize" Value="{DynamicResource FontXSmall}" />
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		</Style>
		<Style Selector="TextBlock.error-mono">
			<Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
			<Setter Property="FontSize" Value="{DynamicResource FontDetail}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Opacity" Value="0.75" />
		</Style>
	</suki:SukiWindow.Styles>

	<!--
		painted root: solid flat canvas over the SukiUI shader — no gradient, no waves.
		the chrome — titlebar, sidebar and the ring around the main card — paints
		WindowChromeBrush; the main area floats on it as a rounded SurfaceBrush card
	-->
	<Grid x:Name="LayoutRoot" Background="{DynamicResource WindowChromeBrush}">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="12" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  Sidebar: workspaces + their chats  -->
		<Border
			Grid.Column="0"
			Margin="10,10,0,10"
			Padding="10"
			IsVisible="{Binding SidebarVisible}">
			<Grid RowDefinitions="*,Auto">
				<ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
					<!--
						explicit viewport width: the ScrollViewer's own horizontal measure goes
						stale across splitter drags, leaving the rows shifted/overflowing
					-->
					<StackPanel Width="{Binding $parent[ScrollViewer].Viewport.Width}" Spacing="10">
						<!--
							Background=Transparent keeps :pointerover alive across the whole strip:
							without it only the TextBlock glyphs are hover-testable and the + hides
							the moment the pointer crosses the gap toward it
						-->
						<Grid
							Background="Transparent"
							Classes="projects-header"
							ColumnDefinitions="*,Auto"
							ColumnSpacing="4">
							<TextBlock
								VerticalAlignment="Center"
								FontSize="{DynamicResource FontSmall}"
								FontWeight="SemiBold"
								Opacity="0.7"
								Text="Workspaces" />
							<Button
								Grid.Column="1"
								Classes="icon ws-action"
								Click="OnAddWorkspaceClicked"
								ToolTip.Tip="Add workspace folder">
								<PathIcon
									Width="{DynamicResource IconBody}"
									Height="{DynamicResource IconBody}"
									Data="{StaticResource IconPlus}" />
							</Button>
						</Grid>
						<ItemsControl ItemsSource="{Binding Workspaces}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<StackPanel Margin="0,1">
										<Border
											Classes="row-card"
											Tapped="OnWorkspaceClick"
											ToolTip.Tip="{Binding ToolTipText}">
											<Border.ContextMenu>
												<ContextMenu>
													<MenuItem
														Click="OnWorkspaceOpenFolderClick"
														Header="Open folder"
														IsVisible="{Binding !IsGeneral}" />
													<MenuItem
														Click="OnWorkspaceOpenInOpenCodeClick"
														Header="Open in opencode"
														IsVisible="{Binding !IsGeneral}" />
													<MenuItem
														Click="OnWorkspaceStartClick"
														Header="Start server"
														IsVisible="{Binding !IsRunning}" />
													<MenuItem
														Click="OnWorkspaceStopClick"
														Header="Stop server"
														IsVisible="{Binding IsRunning}" />
													<MenuItem
														Click="OnWorkspaceRemoveClick"
														Header="Remove workspace"
														IsVisible="{Binding !IsGeneral}" />
												</ContextMenu>
											</Border.ContextMenu>
											<Grid ColumnDefinitions="*,Auto">
												<StackPanel Orientation="Horizontal" Spacing="7">
													<Panel VerticalAlignment="Center">
														<PathIcon
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Data="{StaticResource IconFolderOpenOutline}"
															Foreground="{DynamicResource TextMutedBrush}"
															IsVisible="{Binding ShowOpenFolder}" />
														<PathIcon
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Data="{StaticResource IconFolderOutline}"
															Foreground="{DynamicResource TextMutedBrush}"
															IsVisible="{Binding ShowClosedFolder}" />
														<!--  General is a chat, not a folder: one steady glyph  -->
														<PathIcon
															Width="{DynamicResource IconBody}"
															Height="{DynamicResource IconBody}"
															Data="{StaticResource IconChatOutline}"
															Foreground="{DynamicResource TextMutedBrush}"
															IsVisible="{Binding IsGeneral}" />
													</Panel>
													<TextBlock
														VerticalAlignment="Center"
														FontSize="{DynamicResource FontBody}"
														Text="{Binding Name}"
														TextTrimming="CharacterEllipsis" />
													<Ellipse
														Width="6"
														Height="6"
														VerticalAlignment="Center"
														Fill="{DynamicResource SuccessBrush}"
														IsVisible="{Binding IsRunning}" />
												</StackPanel>
												<!--  right side swaps by row hover: chat count at rest, actions on hover  -->
												<Grid Grid.Column="2" VerticalAlignment="Center">
													<TextBlock
														VerticalAlignment="Center"
														HorizontalAlignment="Right"
														Classes="row-time"
														FontSize="{DynamicResource FontMicro}"
														IsVisible="{Binding HasChats}"
														Text="{Binding Chats.Count}" />
													<StackPanel
														Orientation="Horizontal"
														Spacing="2">
														<Button
															Classes="icon ws-action"
															Click="OnWorkspaceMenuClick"
															ToolTip.Tip="Workspace actions">
															<PathIcon
																Width="{DynamicResource IconBody}"
																Height="{DynamicResource IconBody}"
																Data="{StaticResource IconKebab}" />
														</Button>
														<Button
															Classes="icon ws-action"
															Command="{Binding $parent[ItemsControl].DataContext.NewChatForWorkspaceCommand}"
															CommandParameter="{Binding}"
															ToolTip.Tip="New chat in this workspace">
															<PathIcon
																Width="{DynamicResource IconBody}"
																Height="{DynamicResource IconBody}"
																Data="{StaticResource IconChatOutline}" />
														</Button>
													</StackPanel>
												</Grid>
											</Grid>
										</Border>
										<StackPanel IsVisible="{Binding IsExpanded}">
											<TextBlock
												Margin="26,1,0,1"
												HorizontalAlignment="Left"
												Classes="sidebar-hint"
												IsVisible="{Binding ShowEmptyHint}"
												Text="No chats yet"
												TextAlignment="Left" />
											<ItemsControl ItemsSource="{Binding Chats}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Border
															Margin="26,0,0,0"
															Classes="row-card"
															Classes.selected="{Binding IsSelected}"
															Tapped="OnSessionClick"
															ToolTip.Tip="{Binding Title}">
															<Border.ContextMenu>
																<ContextMenu>
																	<MenuItem
																		Click="OnPinClick"
																		Header="Pin"
																		IsVisible="{Binding !IsPinned}" />
																	<MenuItem
																		Click="OnUnpinClick"
																		Header="Unpin"
																		IsVisible="{Binding IsPinned}" />
																	<MenuItem Click="OnRenameClick" Header="Rename" />
																	<MenuItem Click="OnUnlinkClick" Header="Remove from workspace" />
																	<MenuItem Click="OnDeleteClick" Header="Delete" />
																</ContextMenu>
															</Border.ContextMenu>
															<Grid ColumnDefinitions="13,*,Auto" ColumnSpacing="5">
																<!--
																	gutter: spinner while the turn runs, pin otherwise —
																	titles stay aligned across all chat rows
																-->
																<Panel VerticalAlignment="Center">
																	<PathIcon
																		Width="{DynamicResource IconSmall}"
																		Height="{DynamicResource IconSmall}"
																		Classes="spin"
																		Data="{StaticResource IconSpinner}"
																		IsVisible="{Binding IsRunning}" />
																	<PathIcon
																		Width="{DynamicResource IconXSmall}"
																		Height="{DynamicResource IconXSmall}"
																		VerticalAlignment="Center"
																		Data="{StaticResource IconPin}"
																		Foreground="{DynamicResource TextMutedBrush}"
																		IsVisible="{Binding PinVisible}" />
																</Panel>
																<TextBlock
																	Grid.Column="1"
																	VerticalAlignment="Center"
																	FontSize="{DynamicResource FontBody}"
																	IsVisible="{Binding !IsEditing}"
																	Text="{Binding Title}"
																	TextTrimming="CharacterEllipsis" />
																<TextBox
																	Grid.Column="1"
																	IsVisible="{Binding IsEditing}"
																	KeyDown="OnRenameKeyDown"
																	LostFocus="OnRenameLostFocus"
																	Text="{Binding DraftTitle}" />
																<!--  column 2 swaps by row hover: updated-at time at rest, delete on hover  -->
																<TextBlock
																	Grid.Column="2"
																	VerticalAlignment="Center"
																	Classes="row-time"
																	FontSize="{DynamicResource FontMicro}"
																	IsVisible="{Binding !IsEditing}"
																	Text="{Binding UpdatedLabel}" />
																<Button
																	Grid.Column="2"
																	Classes="icon ws-action"
																	Click="OnDeleteClick"
																	ToolTip.Tip="Delete chat">
																	<PathIcon
																		Width="{DynamicResource IconXSmall}"
																		Height="{DynamicResource IconXSmall}"
																		Data="{StaticResource IconTrash}" />
																</Button>
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</StackPanel>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasNoWorkspace}"
							Text="Add a workspace folder to begin." />
					</StackPanel>
				</ScrollViewer>
				<Button
					Grid.Row="1"
					Classes="settings-btn"
					Command="{Binding OpenSettingsCommand}"
					ToolTip.Tip="Settings">
					<StackPanel Orientation="Horizontal" Spacing="7">
						<PathIcon
							Width="{DynamicResource IconMedium}"
							Height="{DynamicResource IconMedium}"
							Data="{StaticResource IconCog}" />
						<TextBlock
							VerticalAlignment="Center"
							FontSize="{DynamicResource FontSmall}"
							Text="Settings" />
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!--  drag to resize the sidebar; hidden together with it  -->
		<GridSplitter
			Grid.Column="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Background="Transparent"
			IsVisible="{Binding SidebarVisible}"
			ResizeBehavior="PreviousAndNext"
			ResizeDirection="Columns" />

		<Grid Grid.Column="2">
			<!--
				rounded main-area card: floats on the dark chrome; the content grid
				above it stays transparent so the corners read through
			-->
			<Border
				Background="{DynamicResource SurfaceBrush}"
				BorderBrush="{DynamicResource HairlineBrush}"
				BorderThickness="0"
				CornerRadius="12" />
			<Grid RowDefinitions="*">

				<!--  Tile grid: every open chat is one tile  -->
				<Grid >
					<ItemsControl ItemsSource="{Binding OpenTiles}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<UniformGrid Columns="{Binding TileColumns}" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<v:ChatTile Margin="4" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<StackPanel
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding !HasTiles}">
						<PathIcon
							Width="56"
							Height="56"
							Margin="0,0,0,16"
							HorizontalAlignment="Center"
							Data="{StaticResource IconSpark}"
							Foreground="{DynamicResource SparkFillBrush}" />
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasNoWorkspace}"
							Text="Add a workspace folder to begin." />
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasIdleWorkspace}"
							Text="Start the server to load your chats." />
						<TextBlock
							Classes="sidebar-hint"
							IsVisible="{Binding HasRunningWorkspace}"
							Text="Open a chat from the sidebar, or start a new one with the + next to a workspace." />
					</StackPanel>

					<!--  relaunch offer: the last session left chats tiled  -->
					<Border
						Margin="0,12,0,0"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Classes="restore-bar"
						IsVisible="{Binding ShowRestorePrompt}">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<PathIcon
								Width="{DynamicResource IconMedium}"
								Height="{DynamicResource IconMedium}"
								VerticalAlignment="Center"
								Data="{StaticResource IconClock}"
								Foreground="{DynamicResource TextMutedBrush}" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="{DynamicResource FontBody}"
								Text="{Binding RestorePromptText}" />
							<Button
								Classes="btn-soft"
								Command="{Binding RestorePreviousSessionCommand}"
								ToolTip.Tip="Reopen the chats from the last session">
								<TextBlock
									VerticalAlignment="Center"
									FontSize="{DynamicResource FontBody}"
									Text="Restore" />
							</Button>
							<Button
								Classes="btn-soft"
								Command="{Binding DismissRestorePromptCommand}"
								ToolTip.Tip="Discard the saved tile list">
								<TextBlock
									VerticalAlignment="Center"
									FontSize="{DynamicResource FontBody}"
									Text="Ignore" />
							</Button>
						</StackPanel>
					</Border>

					<!--
						Settings page: covers the tile grid while open (same cell, later
						child = on top; Row 1 would fall into an implicit row and leak
						the tile grid above it)
					-->
					<Border
						Background="{DynamicResource SettingsBgBrush}"
						CornerRadius="12"
						IsVisible="{Binding IsSettingsOpen}">
						<ScrollViewer HorizontalScrollBarVisibility="Disabled">
							<StackPanel
								MaxWidth="1040"
								Margin="28,24"
								HorizontalAlignment="Left"
								x:DataType="vm:SettingsPageViewModel"
								DataContext="{Binding SettingsPage}"
								Spacing="18">
								<Grid ColumnDefinitions="*,Auto">
									<TextBlock
										VerticalAlignment="Center"
										FontSize="{DynamicResource FontTitle}"
										FontWeight="SemiBold"
										Text="Settings" />
									<Button
										Grid.Column="1"
										Classes="btn-soft"
										Command="{Binding $parent[Window].DataContext.CloseSettingsCommand}"
										ToolTip.Tip="Close without saving">
										<StackPanel Orientation="Horizontal" Spacing="6">
											<PathIcon
												Width="{DynamicResource IconXSmall}"
												Height="{DynamicResource IconXSmall}"
												Data="{StaticResource IconClose}" />
											<TextBlock VerticalAlignment="Center" Text="Back" />
										</StackPanel>
									</Button>
								</Grid>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
									<StackPanel Grid.Column="0" Spacing="18">

										<!--  server  -->
										<StackPanel Spacing="6">
											<TextBlock Classes="settings-section" Text="Server" />
											<Border Classes="settings-card">
												<StackPanel Spacing="8">
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="OpenCode executable" />
														<TextBox
															Grid.Column="1"
															PlaceholderText="opencode"
															Text="{Binding OpenCodeExecutable}"
															ToolTip.Tip="Binary name (resolved on PATH) or full path to the opencode executable" />
													</Grid>
													<TextBlock Classes="settings-hint" Text="Running servers keep their current binary until stopped and started again." />
												</StackPanel>
											</Border>
										</StackPanel>

										<!--  chat defaults  -->
										<StackPanel Spacing="6">
											<TextBlock Classes="settings-section" Text="Chat defaults" />
											<Border Classes="settings-card">
												<StackPanel Spacing="10">
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Model" />
														<TextBox
															Grid.Column="1"
															PlaceholderText="provider/model-id — empty = server default"
															Text="{Binding DefaultModel}" />
													</Grid>
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Variant" />
														<TextBox
															Grid.Column="1"
															PlaceholderText="empty = model default"
															Text="{Binding DefaultVariant}" />
													</Grid>
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Agent" />
														<TextBox
															Grid.Column="1"
															PlaceholderText="empty = default build"
															Text="{Binding DefaultAgent}" />
													</Grid>
												</StackPanel>
											</Border>
										</StackPanel>

									</StackPanel>
									<StackPanel Grid.Column="1" Spacing="18">

										<!--  appearance  -->
										<StackPanel Spacing="6">
											<TextBlock Classes="settings-section" Text="Appearance" />
											<Border Classes="settings-card">
												<StackPanel Spacing="12">
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Text size" />
														<StackPanel
															Grid.Column="1"
															Orientation="Horizontal"
															Spacing="14">
															<RadioButton
																Content="Small"
																GroupName="TextSize"
																IsChecked="{Binding IsTextCompact}" />
															<RadioButton
																Content="Normal"
																GroupName="TextSize"
																IsChecked="{Binding IsTextNormal}" />
															<RadioButton
																Content="Large"
																GroupName="TextSize"
																IsChecked="{Binding IsTextLarge}" />
														</StackPanel>
													</Grid>
													<TextBlock
														Margin="160,0,0,0"
														Classes="settings-hint"
														Text="Applied across the app as soon as it's saved." />
													<Border Height="1" Background="{DynamicResource HairlineBrush}" />
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Accent" />
														<ItemsControl Grid.Column="1" ItemsSource="{Binding AccentOptions}">
															<ItemsControl.ItemsPanel>
																<ItemsPanelTemplate>
																	<StackPanel Orientation="Horizontal" Spacing="10" />
																</ItemsPanelTemplate>
															</ItemsControl.ItemsPanel>
															<ItemsControl.ItemTemplate>
																<DataTemplate>
																	<RadioButton
																		Classes="accent-swatch"
																		GroupName="Accent"
																		IsChecked="{Binding IsSelected, Mode=TwoWay}"
																		ToolTip.Tip="{Binding Label}" />
																</DataTemplate>
															</ItemsControl.ItemTemplate>
														</ItemsControl>
													</Grid>
													<TextBlock
														Margin="160,0,0,0"
														Classes="settings-hint"
														Text="Green, amber, salmon and four gray tones; recolors selected states, focus ring and success dots." />
													<Border Height="1" Background="{DynamicResource HairlineBrush}" />
													<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
														<TextBlock Classes="settings-label" Text="Tooltips" />
														<CheckBox
															Grid.Column="1"
															VerticalAlignment="Center"
															Content="Show on hover"
															IsChecked="{Binding ShowToolTips}" />
													</Grid>
												</StackPanel>
											</Border>
										</StackPanel>

										<!--  permissions  -->
										<StackPanel Spacing="6">
											<TextBlock Classes="settings-section" Text="Permissions" />
											<Border Classes="settings-card">
												<StackPanel Spacing="12">
													<CheckBox Content="Auto-allow tool permissions (edit, bash, webfetch)" IsChecked="{Binding AutoAllow}" />
													<StackPanel IsVisible="{Binding AutoAllow}" Spacing="10">
														<Border Height="1" Background="{DynamicResource HairlineBrush}" />
														<CheckBox
															Content="Allow immediately (skip the random wait)"
															IsChecked="{Binding AutoAllowInstant}" />
														<StackPanel IsVisible="{Binding !AutoAllowInstant}" Spacing="10">
														<TextBlock
															Classes="settings-label"
															FontWeight="SemiBold"
															Text="Auto-allow delay" />
														<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
															<TextBlock Classes="settings-label" Text="Working hours" />
															<StackPanel
																Grid.Column="1"
																VerticalAlignment="Center"
																Orientation="Horizontal"
																Spacing="6">
																<TextBox
																	Width="64"
																	Text="{Binding AutoAllowDefaultMin}"
																	ToolTip.Tip="Minimum random wait" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="–" />
																<TextBox
																	Width="64"
																	Text="{Binding AutoAllowDefaultMax}"
																	ToolTip.Tip="Maximum random wait" />
																<TextBlock
																	VerticalAlignment="Center"
																	FontSize="{DynamicResource FontSmall}"
																	FontStyle="Italic"
																	Opacity="0.5"
																	Text="seconds" />
															</StackPanel>
														</Grid>
														<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
															<TextBlock Classes="settings-label" Text="Lunch" />
															<StackPanel
																Grid.Column="1"
																VerticalAlignment="Center"
																Orientation="Horizontal"
																Spacing="6">
																<TextBox
																	Width="52"
																	Text="{Binding LunchStartHour}"
																	ToolTip.Tip="Lunch start hour" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="–" />
																<TextBox
																	Width="52"
																	Text="{Binding LunchEndHour}"
																	ToolTip.Tip="Lunch end hour" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="→" />
																<TextBox
																	Width="64"
																	Text="{Binding AutoAllowAwayMin}"
																	ToolTip.Tip="Minimum random wait" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="–" />
																<TextBox
																	Width="64"
																	Text="{Binding AutoAllowAwayMax}"
																	ToolTip.Tip="Maximum random wait" />
															</StackPanel>
														</Grid>
														<Grid ColumnDefinitions="150,*" ColumnSpacing="10">
															<TextBlock Classes="settings-label" Text="Off hours" />
															<StackPanel
																Grid.Column="1"
																VerticalAlignment="Center"
																Orientation="Horizontal"
																Spacing="6">
																<TextBox
																	Width="52"
																	Text="{Binding OffHoursStartHour}"
																	ToolTip.Tip="Off-hours start hour" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="→" />
																<TextBox
																	Width="52"
																	Text="{Binding WorkdayStartHour}"
																	ToolTip.Tip="Workday start hour next morning" />
																<TextBlock
																	VerticalAlignment="Center"
																	Opacity="0.8"
																	Text="→" />
																<TextBlock
																	VerticalAlignment="Center"
																	FontStyle="Italic"
																	Opacity="0.6"
																	Text="same range as lunch" />
															</StackPanel>
														</Grid>
														<TextBlock Classes="settings-hint" Text="Random wait before auto-allow, picked by local time: working hours use the short range, lunch and off hours the long one." />
														</StackPanel>
													</StackPanel>
												</StackPanel>
											</Border>
										</StackPanel>

									</StackPanel>
								</Grid>

								<Button
									HorizontalAlignment="Left"
									Classes="btn-soft"
									Command="{Binding SaveCommand}">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<PathIcon
											Width="{DynamicResource IconXSmall}"
											Height="{DynamicResource IconXSmall}"
											Data="{StaticResource IconCheck}" />
										<TextBlock VerticalAlignment="Center" Text="Save" />
									</StackPanel>
								</Button>
							</StackPanel>
						</ScrollViewer>
					</Border>
				</Grid>
			</Grid>
		</Grid>
		<!--
			error overlay: CrashGuard's last-ditch dialog. An error never takes the app
			down — this explains what failed and hands the full report to the clipboard
		-->
		<Border
			Grid.Column="0"
			Grid.ColumnSpan="3"
			Background="#A6000000"
			IsVisible="{Binding Error.IsVisible}">
			<Border
				MaxWidth="560"
				Margin="24"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				Classes="error-dialog">
				<StackPanel Spacing="12">
					<Grid ColumnDefinitions="Auto,*,Auto">
						<PathIcon
							Width="{DynamicResource IconLarge}"
							Height="{DynamicResource IconLarge}"
							VerticalAlignment="Top"
							Data="{StaticResource IconWarn}"
							Foreground="{DynamicResource DangerBrush}" />
						<StackPanel
							Grid.Column="1"
							Margin="10,0,0,0"
							Spacing="2">
							<TextBlock
								FontSize="{DynamicResource FontBodyLarge}"
								FontWeight="SemiBold"
								Text="Something went wrong" />
							<TextBlock Classes="error-sub" Text="{Binding Error.Source}" />
						</StackPanel>
						<Button
							Grid.Column="2"
							Classes="icon"
							Click="OnCloseErrorClick"
							ToolTip.Tip="Dismiss">
							<PathIcon
								Width="{DynamicResource IconSmall}"
								Height="{DynamicResource IconSmall}"
								Data="{StaticResource IconClose}" />
						</Button>
					</Grid>
					<TextBlock
						Classes="error-sub"
						Foreground="{DynamicResource DangerBrush}"
						IsVisible="{Binding Error.IsFatal}"
						Text="This error is fatal — the app closes when you continue."
						TextWrapping="Wrap" />
					<TextBlock
						FontSize="{DynamicResource FontBody}"
						Text="{Binding Error.ErrorMessage}"
						TextWrapping="Wrap" />
					<Border Classes="error-detail">
						<ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
							<TextBlock Classes="error-mono" Text="{Binding Error.ErrorDetails}" />
						</ScrollViewer>
					</Border>
					<Grid ColumnDefinitions="Auto,*">
						<TextBlock
							VerticalAlignment="Center"
							Classes="error-sub"
							IsVisible="{Binding Error.HasMore}"
							Text="{Binding Error.MoreCount, StringFormat='+{0} more waiting'}" />
						<StackPanel
							Grid.Column="1"
							HorizontalAlignment="Right"
							Orientation="Horizontal"
							Spacing="8">
							<Button
								Classes="btn-soft"
								Click="OnCopyErrorClick"
								ToolTip.Tip="Copy the full report">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon
										Width="{DynamicResource IconXSmall}"
										Height="{DynamicResource IconXSmall}"
										Data="{StaticResource IconCopy}" />
									<TextBlock VerticalAlignment="Center" Text="Copy details" />
								</StackPanel>
							</Button>
							<Button
								Classes="btn-soft"
								Click="OnCloseErrorClick"
								ToolTip.Tip="Keep going">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon
										Width="{DynamicResource IconXSmall}"
										Height="{DynamicResource IconXSmall}"
										Data="{StaticResource IconCheck}" />
									<TextBlock VerticalAlignment="Center" Text="Continue" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</suki:SukiWindow>
